  setup lifetime=3 intention=IDLE p=out aggro-list holds p2
  p moves in range
  tick 1
    see p lifetime=3 intention=IDLE
    add attack desire on p -> intention=IDLE
    after intention=ATTACK lifetime=4
  tick 2
    after intention=ATTACK lifetime=5
row queued-attack-before-first-tick attack=false start=in age=0 aggro_list_held=false
