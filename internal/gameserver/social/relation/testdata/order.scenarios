# Scenarios replayed by RelationOrderProbe.java and by TestListOrderMatchesReferenceProbe.
# See oracle/README.md for the line format.

# Two friends (and two blocked ids) sharing a bucket of the list's set, added
# in descending order: the list keeps the order they were added in.
scenario same-bucket
friend 268435556 268435476
friend 268435556 268435460
block 268435556 268435508
block 268435556 268435492
list 268435556

# Rows loaded in primary-key order, one pair listed twice (reversed), then a
# pair cleared and set again: it keeps its place in the store.
scenario load-order
load 268435460 268435556 1
load 268435476 268435556 3
load 268435480 268435490 1 0 16 12
load 268435556 268435572 1 0 16 10
load 268435572 268435556 2
list 268435556
list 268435480
unfriend 268435556 268435460
friend 268435460 268435556
list 268435556

# Nine pairs with one hash land in one bin of a 16-bin store, which jumps to
# 128 bins.
scenario store-presize-on-insert
friend 268435700 268435701 0 1 5
list 268435700
block 268435500 268436000 1 -31 9
list 268435700
friend 268435700 268435801 0 3 9
list 268435700

# Eight pairs with one hash: a friend's second update finds its pair in eighth
# place, which grows the store as a ninth pair would; a block's single update
# does not, but unblocking it again does.
scenario store-presize-on-update
friend 268435700 268435701 0 1 3
friend 268435500 268436000 1 -31 8
list 268435700
scenario store-presize-on-unblock
friend 268435700 268435701 0 1 3
block 268435500 268436000 1 -31 8
list 268435700
unblock 268435507 268435783
list 268435700

# A 128-bin store gets twelve pairs of one character in one bin: a tree, which
# takes later pairs at its front, then splits as the store grows. The list's
# set gets those twelve ids in one bucket too and treeifies it at 64 buckets,
# then keeps the whole tree when it grows to 128.
scenario tree-bins
friend 268440000 268440001 2 2 60
friend 268436456 268437000 0 128 12
list 268436456
friend 268450000 268450001 2 2 120
list 268436456
friend 268436456 268460000 0 1 40
list 268436456
friend 268436456 268437000 0 64 31
list 268436456
friend 268470000 268470001 2 2 400
list 268436456

# The list's set treeifies a bucket of 64-apart ids, then splits it: into two
# trees, or into two lists.
scenario set-tree-split
friend 268436457 268438000 0 64 20
friend 268436457 268439001 0 1 32
list 268436457
friend 268436458 268441000 0 64 9
friend 268436458 268442001 0 1 40
list 268436458

