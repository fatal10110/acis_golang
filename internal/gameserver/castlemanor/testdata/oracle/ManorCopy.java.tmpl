		// Castle.riseSeedIncome without its taxes (the probe's castle is
		// untaxed), cap and store: only the guard on the amount matters here.
		void riseSeedIncome(long income)
		{
			if (ownerId <= 0 || income <= 0)
				return;
			seedIncome += income;
		}

		// Castle.editTreasury without its store.
		boolean editTreasury(long amount, boolean save)
		{
			if (ownerId <= 0 || amount == 0)
				return false;
			if (amount < 0)
			{
				if (treasury < Math.abs(amount))
					return false;
				treasury += amount;
			}
			else if (treasury + amount > Integer.MAX_VALUE)
				treasury = Integer.MAX_VALUE;
			else
				treasury += amount;
			return true;
		}
	}

