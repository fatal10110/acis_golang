/**
 * The engine's block lookup and its two fly queries, cut verbatim from the reference. The
 * reference engine cannot be constructed without region files, so this holds only the block grid
 * the cut methods read; the probe fills it with synthetic blocks.
 */
public class GeoCopy
{
	private final ABlock[][] _blocks = new ABlock[GeoStructure.GEO_BLOCKS_X][GeoStructure.GEO_BLOCKS_Y];
	
	public GeoCopy()
	{
		final BlockNull nullBlock = new BlockNull();
		for (ABlock[] column : _blocks)
			java.util.Arrays.fill(column, nullBlock);
	}
	
	public void setBlock(int blockX, int blockY, ABlock block)
	{
		_blocks[blockX][blockY] = block;
	}
	
