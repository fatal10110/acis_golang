# Orfen (29014), a level 1 grand boss, sees the level 1 character cast Ultimate Debuff (4694, 100
# aggro points) on a monster beside it, from within 1000. On a draw under 20 of 100 it names the
# character in one of four lines (a draw of 100 under 25, 50, 75, the rest), teleports it to where
# it stands, once Orfen's task is done, and wants its paralysis (4063) on it. On a draw of 20 it
# does neither. A relog after each pull lets the character, which never sends Appearing here, cast
# again. The character's combat draws are pinned so the debuff lands.
character Hunter 1
skill 4694 1
roll player 0
random 0 0 0 25 0 50 0 75 20
script script.ai.individual.DefaultNpc
script script.ai.boss.orfen.Orfen
npc orfen 29014 GrandBoss 250 0 0 skill HOLD_MAGIC 4063 1
npc wolf 20120 Monster 150 0 0

cast wolf 4694
  S MagicSkillUse caster=player target=wolf skill=4694-1 hit=0 reuse=0 success=0
  S SystemMessage id=46 4:4694,1
  S NpcSay obj=orfen type=0 npc=1029014 text="Hunter. Stop kidding yourself about your own powerlessness!"
  S ActionFailed
  S ActionFailed
  S ActionFailed
  S ActionFailed
  S ActionFailed
  S TeleportToLocation obj=player loc=260,20,30 fast=0
  S DeleteObject obj=orfen
  S DeleteObject obj=wolf
  desires orfen cast(player,4063,move)=1000000
relog
cast wolf 4694
  S MagicSkillUse caster=player target=wolf skill=4694-1 hit=0 reuse=0 success=0
  S SystemMessage id=46 4:4694,1
  S NpcSay obj=orfen type=0 npc=1029014 text="Hunter. I'll make you feel what true fear is!"
  S ActionFailed
  S ActionFailed
  S ActionFailed
  S ActionFailed
  S ActionFailed
  S TeleportToLocation obj=player loc=260,20,30 fast=0
  S DeleteObject obj=orfen
  S DeleteObject obj=wolf
relog
cast wolf 4694
  S MagicSkillUse caster=player target=wolf skill=4694-1 hit=0 reuse=0 success=0
  S SystemMessage id=46 4:4694,1
  S NpcSay obj=orfen type=0 npc=1029014 text="You're really stupid to have challenged me. Hunter! Get ready!"
  S ActionFailed
  S ActionFailed
  S ActionFailed
  S ActionFailed
  S ActionFailed
  S TeleportToLocation obj=player loc=260,20,30 fast=0
  S DeleteObject obj=orfen
  S DeleteObject obj=wolf
relog
cast wolf 4694
  S MagicSkillUse caster=player target=wolf skill=4694-1 hit=0 reuse=0 success=0
  S SystemMessage id=46 4:4694,1
  S NpcSay obj=orfen type=0 npc=1029014 text="Hunter. Do you think that's going to work?!"
  S ActionFailed
  S ActionFailed
  S ActionFailed
  S ActionFailed
  S ActionFailed
  S TeleportToLocation obj=player loc=260,20,30 fast=0
  S DeleteObject obj=orfen
  S DeleteObject obj=wolf
relog
cast wolf 4694
  S MagicSkillUse caster=player target=wolf skill=4694-1 hit=0 reuse=0 success=0
  S SystemMessage id=46 4:4694,1
