# TyrannoPrimeval (22215), every draw 0, in a fight: the capture skill matching its last social animation (5106)
# landing on it wants its first debuff on itself, sets the capture stage and arms the capture timer for
# CaptureCycle (10) plus a CaptureCycleRand draw (0) seconds; a capture skill that does not match (5107) wants its
# matching cancel (5100) on itself and remembers the caster. At the timer, still in combat with the stage set, a draw
# under ProbTimer (100) wants its cancel-all on itself, clears the stage and plays social animation 0.
character Hunter 20
random always 0
script script.ai.individual.DefaultNpc
script script.ai.individual.Monster.MonsterAI
script script.ai.individual.Monster.WarriorBase.WarriorBase
script script.ai.individual.Monster.WarriorBase.Warrior.Warrior
script script.ai.individual.Monster.WarriorBase.Warrior.TyrannoPrimeval.TyrannoPrimeval
npc rex 22215 Monster 300 0 0 skill SELF_BUFF1 5087 1 skill SELF_BUFF2 5087 2 skill DEBUFF1 5098 1 skill DEBUFF2 5098 2 skill CAPTURE_CANCEL_A 5099 1 skill CAPTURE_CANCEL_B 5100 1 skill CAPTURE_CANCEL_C 5101 1 skill CAPTURE_CANCEL_ALL 5102 1 skill LONG_RANGE_DD_MAGIC1 5120 1 ai CaptureCycle=10,CaptureCycleRand=4

hit rex 10
  S MagicSkillUse caster=rex target=rex skill=5087-2 hit=5285 reuse=0 success=0
  desires rex attack(player)=125 cast(rex,5087,move)=1000000 cast(player,5120,move)=1000000
stance rex on
land rex 5106 1
  mem rex i_quest0=1
land rex 5107 1 by player
  mem rex c_ai0=player
advance 12s
  S MagicSkillUse caster=rex target=rex skill=5098-1 hit=0 reuse=0 success=0
  S MagicSkillUse caster=rex target=rex skill=5100-1 hit=10571 reuse=0 success=0
  mem rex i_quest0=0 i_quest1=0
