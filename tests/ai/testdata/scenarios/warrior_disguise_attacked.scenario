# WarriorDisguise (21266, Cave Ant Larva, silhouette 21269): the first hit puts the silhouette where
# it stands, raised with the attacker as its parameter, and removes the larva from the world; the
# larva is hit once only.
character Hunter 20
random always 0
script script.ai.individual.DefaultNpc
script script.ai.individual.Monster.MonsterAI
script script.ai.individual.Monster.WarriorBase.WarriorBase
script script.ai.individual.Monster.WarriorBase.Warrior.Warrior
script script.ai.individual.Monster.WarriorBase.Warrior.WarriorDisguise
npc larva 21266 Monster 100 0 0 level 36 ai silhouette=21269
npc silhouette 21269 Monster 5000 0 0

hit larva 10
  S NpcInfo obj=silhouette npc=21269
  S ChangeMoveType obj=silhouette running=1 swimming=0
  S NpcInfo obj=silhouette npc=21269
  S DeleteObject obj=larva
  inworld larva no
  live 21269 2
