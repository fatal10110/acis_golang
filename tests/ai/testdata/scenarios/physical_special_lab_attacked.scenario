# WarriorPhysicalSpecialLabAggressive (22059, its shipped skills), every draw 0, 100 away from
# the character. A hit on a draw under 33 wants its self-centred physical special skill (4641-5)
# at the character, weight 1000000, which the hit's desire selection casts; the character, alone,
# draws no self buff from WarriorCastingEnchantLabClan2.
character Hunter 20
random always 0
script script.ai.individual.DefaultNpc
script script.ai.individual.Monster.MonsterAI
script script.ai.individual.Monster.WarriorBase.WarriorBase
script script.ai.individual.Monster.WarriorBase.Warrior.Warrior
script script.ai.individual.Monster.WarriorBase.Warrior.WarriorCastingEnchantLabClan1.WarriorCastingEnchantLabClan1
script script.ai.individual.Monster.WarriorBase.Warrior.WarriorCastingEnchantLabClan1.WarriorCastingEnchantLabClan2.WarriorCastingEnchantLabClan2
script script.ai.individual.Monster.WarriorBase.Warrior.WarriorCastingEnchantLabClan1.WarriorCastingEnchantLabClan2.WarriorPhysicalSpecialLabAggressive
npc golem 22059 Monster 100 0 0 skill SELF_RANGE_PHYSICAL_SPECIAL 4641 5 skill SELF_BUFF1 4471 1 skill SELF_BUFF2 4471 2

hit golem 22
  S MagicSkillUse caster=golem target=player skill=4641-5 hit=2378 reuse=7928 success=0
  desires golem attack(player)=275 cast(player,4641,move)=1000000
