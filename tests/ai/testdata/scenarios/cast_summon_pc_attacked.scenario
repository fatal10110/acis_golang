# WarriorCastSummonPC (20213, its shipped skills), every draw 0, 400 away from the character. Its
# first hit, from farther than 300 on a draw under 50, wants its summon magic (4161) on the
# character, weight 1000000, beside the Warrior's hate, which the hit's desire selection casts.
character Hunter 20
random always 0
script script.ai.individual.DefaultNpc
script script.ai.individual.Monster.MonsterAI
script script.ai.individual.Monster.WarriorBase.WarriorBase
script script.ai.individual.Monster.WarriorBase.Warrior.Warrior
script script.ai.individual.Monster.WarriorBase.Warrior.WarriorCastSummonPC.WarriorCastSummonPC
npc summoner 20213 Monster 400 0 0 skill SUMMON_MAGIC 4161 1 skill PHYSICAL_SPECIAL 4073 4

hit summoner 22
  S MagicSkillUse caster=summoner target=player skill=4161-1 hit=2642 reuse=0 success=0
  desires summoner attack(player)=275 cast(player,4161,move)=1000000
