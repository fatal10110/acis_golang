# WarriorTimerBomb (18340, a hall keeper suicidal soldier of the Frintezza raid), every draw 0:
# its created hook arms timer "1010" for 1 s (a draw of 0, plus 1) and timer "1009" for 10 s (a
# draw of 0, raised to 10), and runs no parent created hook. "1010" makes it walk, then every
# 3 s (a draw of 0, raised to 3) run and walk in turn. "1009" makes it want its self range blast
# (the shipped 5042-9) on itself, weight 1000000.
character Hunter 20
random always 0
script script.ai.individual.DefaultNpc
script script.ai.individual.Monster.MonsterAI
script script.ai.individual.Monster.WarriorBase.WarriorBase
script script.ai.individual.Monster.WarriorBase.Warrior.Warrior
script script.ai.individual.Monster.WarriorBase.Warrior.WarriorTimerBomb
npc bomb 18340 Monster 600 0 0 skill SELF_RANGE_DD_MAGIC 5042 9

advance 9s
  desires bomb -
advance 1s
  desires bomb cast(bomb,5042,move)=1000000
tick x2
  S MagicSkillUse caster=bomb target=bomb skill=5042-9 hit=0 reuse=0 success=0
