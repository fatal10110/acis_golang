# LV3Orc (27294, level 76, glowing at +10), raised for the character (spawn parameters character, character, owner),
# every draw 0: it appears wanting its big body (4692-1) on itself and attacking the creature its first spawn
# parameter named (200). Only a hit by skill 1245 while it is stunned (Shield Stun, 92) moves IntAI0 on (0 to 1,
# dropping the glow): the same hit unstunned leaves both. The 1 s timer does nothing while the stun lasts (9 s);
# once the stun has run out it acts on 1, 3 and 5: it drops its desires, wants the step's debuff on itself (the
# normal body too at 3), moves IntAI0 on and attacks the creature the first spawn parameter named (200).
character Hunter 20
random always 0
script script.ai.individual.DefaultNpc
script script.ai.individual.Monster.MonsterAI
script script.ai.individual.Monster.LV3Monster.LV3Monster
script script.ai.individual.Monster.LV3Monster.LV3Orc
npc owner 20003 Monster 600 0 0
npc orc 27294 Monster 300 0 0 level 76 skill PHYSICAL_SPECIAL3 4032 7 skill PHYSICAL_SPECIAL1 4032 8 skill PHYSICAL_SPECIAL2 4073 8 skill DEBUFF1 4544 1 skill DEBUFF2 4544 2 skill DEBUFF3 4544 3 skill BIG_BODY_SKILL 4692 1 skill NORMAL_BODY_SKILL 4693 1 params character character owner master owner
roll orc 99

tick
  mem orc i_ai0=0
  shows orc glow=10
  desires orc attack(player)=200 cast(orc,4692,move)=1000000
hit orc 1 skill 1245 1
  mem orc i_ai0=0
  shows orc glow=10
land orc 92 1
hit orc 1 skill 28 1
  mem orc i_ai0=0
hit orc 1 skill 1245 1
  mem orc i_ai0=1
  shows orc glow=0
advance 9s
  mem orc i_ai0=1
advance 1s
  S MagicSkillUse caster=orc target=orc skill=4544-1 hit=0 reuse=0 success=0
  mem orc i_ai0=2
  desires orc attack(player)=200 cast(orc,4544,move)=1000000
land orc 92 1
hit orc 1 skill 1245 1
  mem orc i_ai0=3
advance 9s
  mem orc i_ai0=3
advance 1s
  S MagicSkillUse caster=orc target=orc skill=4544-2 hit=0 reuse=0 success=0
  mem orc i_ai0=4
  desires orc attack(player)=200 cast(orc,4544,move)=1000000 cast(orc,4693,move)=1000000
land orc 92 1
hit orc 1 skill 1245 1
  mem orc i_ai0=5
advance 9s
  mem orc i_ai0=5
advance 1s
  S MagicSkillUse caster=orc target=orc skill=4544-3 hit=0 reuse=0 success=0
  mem orc i_ai0=6
  desires orc attack(player)=200 cast(orc,4544,move)=1000000
advance 1s
  mem orc i_ai0=6
