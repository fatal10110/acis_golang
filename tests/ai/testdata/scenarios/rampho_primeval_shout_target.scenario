# RamphoPrimeval (22199) with BroadCastReception 1: a shout-target script event (10016) naming the
# character makes it be attacked by the character for 1000 damage, so it wants to attack the
# character with the hate that call adds (the base reaction's 50 percent reset misses on draw 99);
# an event naming no player does nothing.
character Hunter 20
random always 0
script script.ai.individual.DefaultNpc
script script.ai.individual.Monster.MonsterAI
script script.ai.individual.Monster.WarriorBase.WarriorBase
script script.ai.individual.Monster.WarriorBase.Warrior.Warrior
script script.ai.individual.Monster.WarriorBase.Warrior.RamphoPrimeval
npc rampho 22199 Monster 300 0 0 level 80 ai BroadCastReception=1,mobile_type=0
npc wolf 20120 Monster 200 0 0

event rampho 10016 wolf 0
  desires rampho -
event rampho 10016 character 0
  random always 99
  desires rampho attack(player)=1149.4252873563219
