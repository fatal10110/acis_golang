# WizardHereticPriestAggressive (22143) that cannot pay for its magic (0 MP), every draw 0: a hit by the character
# from 300 away gives up its spells (int slot 0), and wants to attack, weight 1000, only when the character stands
# within its aggro range.
character Hunter 20
random always 0
script script.ai.individual.DefaultNpc
script script.ai.individual.Monster.MonsterAI
script script.ai.individual.Monster.WizardBase.WizardBase
script script.ai.individual.Monster.WizardBase.Wizard.Wizard
script script.ai.individual.Monster.WizardBase.Wizard.WizardHereticPriestAggressive
npc priest 22143 Monster 300 0 0 mp 0 aggro 1000 skill HOLD_MAGIC 4047 9 skill DEBUFF 4466 3 skill W_SHORT_RANGE_DD_MAGIC 4629 9 skill W_LONG_RANGE_DD_MAGIC 4668 9
npc far 22143 Monster 0 600 0 mp 0 skill HOLD_MAGIC 4047 9 skill DEBUFF 4466 3 skill W_SHORT_RANGE_DD_MAGIC 4629 9 skill W_LONG_RANGE_DD_MAGIC 4668 9

hit priest 10
  mem priest i_ai0=1
  desires priest attack(player)=1000
hit far 10
  mem far i_ai0=1
  desires far -
