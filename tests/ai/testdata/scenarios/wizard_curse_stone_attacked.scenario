script script.ai.individual.Monster.WizardBase.Wizard.WizardDDMagic2.WizardCastClanBuffCurseStoneAggressive
npc stone 21338 Monster 300 0 0 level 80 clan ketra_orc_clan 500 skill BUFF1 4030 3 skill DEBUFF 4035 9 skill W_LONG_RANGE_DD_MAGIC 4158 9 skill W_SHORT_RANGE_DD_MAGIC 4561 9 skill BUFF2 4575 2 skill DEBUFF1 4578 1

hit stone 10
  mem stone i_ai2=1
  desires stone cast(player,4158,move)=2000000 cast(stone,4030,move)=1000000 cast(stone,4575,move)=1000000 cast(player,4035,move)=1000000
