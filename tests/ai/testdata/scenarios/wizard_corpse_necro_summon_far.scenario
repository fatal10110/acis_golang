# WizardCorpseNecroSummon (21563, level 67), every draw 0, hating the character: a dead NPC 260 away (not within 200) is left
# alone, no corpse clearing and no private.
character Hunter 20
random always 0
script script.ai.individual.DefaultNpc
script script.ai.individual.Monster.MonsterAI
script script.ai.individual.Monster.WizardBase.WizardBase
script script.ai.individual.Monster.WizardBase.Wizard.Wizard
