# TyrannoPrimeval (22215) with ag_type 1 and BroadCastReception 1, every draw 0: seeing the character out of combat
# wants its long range magic (5120) on it and attacks it; event 10016 naming the character drops its attack desires
# and wants to attack it (100).
character Hunter 20
random always 0
script script.ai.individual.DefaultNpc
script script.ai.individual.Monster.MonsterAI
script script.ai.individual.Monster.WarriorBase.WarriorBase
script script.ai.individual.Monster.WarriorBase.Warrior.Warrior
script script.ai.individual.Monster.WarriorBase.Warrior.TyrannoPrimeval.TyrannoPrimeval
npc rex 22215 Monster 150 0 0 skill SELF_BUFF1 5087 1 skill SELF_BUFF2 5087 2 skill DEBUFF1 5098 1 skill DEBUFF2 5098 2 skill CAPTURE_CANCEL_A 5099 1 skill CAPTURE_CANCEL_B 5100 1 skill CAPTURE_CANCEL_C 5101 1 skill CAPTURE_CANCEL_ALL 5102 1 skill LONG_RANGE_DD_MAGIC1 5120 1 ai ag_type=1,BroadCastReception=1

approach rex
  S MagicSkillUse caster=rex target=player skill=5120-1 hit=1321 reuse=7928 success=0
  desires rex attack(player)=200 cast(player,5120,move)=1000000
event rex 10016 character 0
  desires rex attack(player)=100 cast(player,5120,move)=1000000
