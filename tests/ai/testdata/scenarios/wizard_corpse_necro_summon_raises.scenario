# WizardCorpseNecroSummon (21563, level 67; SummonPrivate 21549), every draw 0, hating the character: the look every 5 s
# sees a dead NPC within 200 (100 away), casts its corpse clearing (4672) at once and places its SummonPrivate on the
# corpse, told (1000, the corpse).
character Hunter 20
random always 0
script script.ai.individual.DefaultNpc
script script.ai.individual.Monster.MonsterAI
script script.ai.individual.Monster.WizardBase.WizardBase
script script.ai.individual.Monster.WizardBase.Wizard.Wizard
script script.ai.individual.Monster.WizardBase.Wizard.WizardDDMagic2.WizardDDMagic2
script script.ai.individual.Monster.WizardBase.Wizard.WizardDDMagic2.WizardCorpseNecro.WizardCorpseNecro
script script.ai.individual.Monster.WizardBase.Wizard.WizardDDMagic2.WizardCorpseNecro.WizardCorpseNecroSummon
npc necro 21563 Monster 1000 0 0 level 67 skill DEBUFF 4047 6 skill W_SHORT_RANGE_DD_MAGIC 4561 6 skill W_LONG_RANGE_DD_MAGIC 4597 6 skill CANCEL 4650 1 skill DD_MAGIC 4654 6 skill CLEAR_CORPSE 4672 1 ai SummonPrivate=21549
npc corpse 20003 Monster 1000 100 0
npc raised 21549 Monster 0 1500 0

kill corpse
  S SystemMessage id=95 1:0 1:0
hit necro 10
advance 6s
  S MagicSkillUse caster=necro target=corpse skill=4672-1 hit=0 reuse=0 success=0
  S NpcInfo obj=raised npc=21549
  S ChangeMoveType obj=raised running=1 swimming=0
  S NpcInfo obj=raised npc=21549
  privates necro 21549=1:1000,corpse,0
