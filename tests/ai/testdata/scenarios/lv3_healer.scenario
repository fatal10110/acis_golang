# LV3Healer (27266, level 76), raised for the character with its own private (spawn parameters 0,
# character, owner), every draw 0: the character's hit on its private makes the healer attack the
# character (the party formula, a share of the leader's weight point), a hit on the healer itself adds
# only the LV3Monster one, and a private's death raises another of its kind in its place.
character Hunter 20
random always 0
script script.ai.individual.DefaultNpc
script script.ai.individual.Monster.MonsterAI
script script.ai.individual.Monster.WarriorBase.WarriorBase
script script.ai.individual.Monster.LV3Monster.LV3Monster
script script.ai.individual.Monster.LV3Monster.LV3Healer
npc owner 20003 Monster 600 0 0
npc healer 27266 Monster 300 0 0 level 76 params 0 character owner master owner privates 20001:1
npc priv 20001 Monster 5000 0 0 master healer

hit priv 10
  desires healer attack(player)=12.048192771084336
hit healer 10
  desires healer attack(player)=24.096385542168676
kill priv
  S NpcInfo obj=priv npc=20001
  S ChangeMoveType obj=priv running=1 swimming=0
  S NpcInfo obj=priv npc=20001
  privates healer 20001=2
