# RaidPrivateHealer (25008, level 1, privates of a master), every draw 0: a hit on one healer by the
# character (level 20, 19 over it) has its fellow want the raid curse on the character (1000000) and its
# heal on the hurt healer (100); a hit on a healer under half its HP adds 1000000 to the heal.
character Hunter 20
random always 0
script script.ai.individual.DefaultNpc
script script.ai.individual.Monster.MonsterAI
script script.ai.individual.Monster.RaidPrivate.RaidPrivateStandard
script script.ai.individual.Monster.RaidPrivate.RaidPrivateHealer
npc master 20003 Monster 400 0 0
npc healer1 25008 Monster 100 0 0 skill HEAL_MAGIC_A 4780 3 skill SELF_RANGE_BUFF_A 4214 3 master master
npc healer2 25008 Monster -100 0 0 skill HEAL_MAGIC_A 4780 3 skill SELF_RANGE_BUFF_A 4214 3 master master

hit healer1 10
  desires healer2 cast(healer1,4780,move)=100 cast(player,4515,move)=1000000
hp healer1 100
hit healer1 10
  desires healer2 cast(healer1,4780,move)=1000200 cast(player,4515,move)=2000000
