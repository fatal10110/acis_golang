# PartyLeaderWizardRangeCurseAggressive (21312, level 74; the npc line gives the range buff 4609, the
# debuff 4047 and the DDs the template lists), every draw 0: its creation sets IntAI1 and CAI2 (itself);
# its first hit wants the range buff on itself and starts the 5 s timer 5001, which then wants the
# debuff on its top desire (the character, set by the scenario) and remembers it in CAI2.
character Hunter 20
random always 0
script script.ai.individual.DefaultNpc
script script.ai.individual.Monster.MonsterAI
script script.ai.individual.Monster.WizardBase.WizardBase
script script.ai.individual.Monster.WizardBase.PartyLeaderWizard.PartyLeaderWizard
script script.ai.individual.Monster.WizardBase.PartyLeaderWizard.PartyLeaderWizardDD2
script script.ai.individual.Monster.WizardBase.PartyLeaderWizard.PartyLeaderWizardRangeCurseAggressive
npc wiz 21312 Monster 300 0 0 level 74 skill DEBUFF 4047 7 skill W_LONG_RANGE_DD_MAGIC 4156 7 skill W_SHORT_RANGE_DD_MAGIC 4160 7 skill RANGE_DD 4571 7 skill RANGE_BUFF 4609 4 skill DEBUFF_CANCEL 4650 1

hit wiz 10
  mem wiz i_ai1=0 i_ai3=1
  desires wiz cast(player,4156,move)=1000000 cast(wiz,4609,move)=1000000
top wiz player
advance 5s
  mem wiz c_ai2=player
  desires wiz cast(player,4047,move)=9999999 cast(player,4156,move)=1000000 cast(wiz,4609,move)=1000000
