  desires zaken attack(player)=27272.727272727272 cast(player,4216,move)=1000000 cast(player,4220,move)=1000000 cast(player,4217,move)=1000000 cast(player,4219,move)=1000000
hit zaken 10
  desires zaken attack(player)=36363.63636363636 cast(player,4216,move)=1000000 cast(player,4220,move)=1000000 cast(player,4217,move)=1000000 cast(player,4219,move)=1000000 cast(player,4218,move)=1000000
hit zaken 10
  desires zaken attack(player)=45454.54545454545 cast(player,4216,move)=1000000 cast(player,4220,move)=1000000 cast(player,4217,move)=1000000 cast(player,4219,move)=1000000 cast(player,4218,move)=1000000
hit zaken 10
  desires zaken attack(player)=54545.45454545454 cast(player,4216,move)=1000000 cast(player,4220,move)=1000000 cast(player,4217,move)=1000000 cast(player,4219,move)=1000000 cast(player,4218,move)=1000000
