npc elcroki 22214 Monster 1000 0 0 level 80 skill LONG_RANGE_DD_MAGIC1 4151 10 skill SELF_RANGE_DEBUFF1 4486 10 skill SELF_RANGE_BUFF1 5080 1 skill SELF_RANGE_DD_MAGIC1 5178 1 mem i_ai3=2,i_ai4=2 ai ag_type=1,silhouette1=22209,silhouette2=22212
npc sil1 22209 Monster 1000 100 0 master elcroki
npc sil2 22209 Monster 1000 -100 0 master elcroki

