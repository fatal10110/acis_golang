# Skirmish with the Orcs (Q105): an elven fighter of level 10 accepts at Kendell, whose order
# (drawn: the third, Batoh) names the chief to slay; slaying another chief first gives nothing.
# Batoh's torque earns the second order (drawn: the fourth, Murtika); Roko gives nothing,
# Murtika the second torque, and Kendell gives the Red Sunset Sword, soulshots, the newbie
# soulshots and the echo crystals; then relog. Expectations replay the reference trace of this
# scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q105_skirmish_with_the_orcs.golden
character Ranger 10
class 18
random 2 3
script quest.Q105_SkirmishWithTheOrcs
item 1836 1837 1838 1839 1840 1841 1842 1843 1844 1845 754 981 1060 1835 2509 4412 4413 4414 4415 4416 5789
page guard/30218.htm
page script/quest/Q105_SkirmishWithTheOrcs/
npc kendell 30218 Guard 10 0 0
npc uoph 27059 Monster 40 0 0
npc batoh 27061 Monster 0 40 0
npc roko 27065 Monster -40 0 0
npc murtika 27068 Monster 0 -40 0

# Kendell: accept, the third order.
action kendell
action kendell
  S ActionFailed
  S NpcHtmlMessage obj=kendell item=0 page=guard/30218.htm
  S ActionFailed
bypass npc_{kendell}_Quest
  S NpcHtmlMessage obj=kendell item=0 page=script/quest/Q105_SkirmishWithTheOrcs/30218-02.htm
  S ActionFailed
  S ActionFailed
