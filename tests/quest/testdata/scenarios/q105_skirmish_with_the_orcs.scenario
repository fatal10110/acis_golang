  S SystemMessage id=54 3:1838
  S NpcHtmlMessage obj=kendell item=0 page=script/quest/Q105_SkirmishWithTheOrcs/30218-03.htm
  S ActionFailed
  Q upsert Q105_SkirmishWithTheOrcs | <state> | STARTED
  Q upsert Q105_SkirmishWithTheOrcs | <cond> | 1
  items 1838=1
  rows Q105_SkirmishWithTheOrcs <cond>=1 <state>=STARTED
action kendell
  S ActionFailed
  S NpcHtmlMessage obj=kendell item=0 page=guard/30218.htm
  S ActionFailed
bypass npc_{kendell}_Quest
  S NpcHtmlMessage obj=kendell item=0 page=script/quest/Q105_SkirmishWithTheOrcs/30218-05.htm
  S ActionFailed
  S ActionFailed

# Uoph is not the ordered chief; Batoh is.
