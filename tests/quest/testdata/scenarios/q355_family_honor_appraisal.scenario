# Family Honor (Q355), appraisals: at cond 1 holding four works of Berona, a troop leader's roll
# of 50 gives a fifth; Patrin appraises the five, one per appraisal roll: nothing, a replica, an
# original, a forgery and a prototype; Galibredo then has no bust to buy and keeps the quest.
# Expectations replay the reference trace of this scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q355_family_honor_appraisal.golden
character Galibredo 36
quest Q355_FamilyHonor <cond>=1 <state>=STARTED
hold 4350 4
random 0 50 0 0 20 40 60 80
script quest.Q355_FamilyHonor
item 57 4252 4350 4351 4352 4353 4354
page merchant/30181.htm
page default/30929.htm
page script/quest/Q355_FamilyHonor/
npc galibredo 30181 Merchant 10 0 0
npc patrin 30929 Folk -10 0 0
npc orc 20767 Monster 40 0 0

# A work of Berona.
kill orc
  S SystemMessage id=95 1:0 1:0
  S SystemMessage id=54 3:4350
  S PlaySound type=0 file=ItemSound.quest_itemget bind=0 obj=0 loc=0,0,0 delay=0
  items 4252=0 4350=5

