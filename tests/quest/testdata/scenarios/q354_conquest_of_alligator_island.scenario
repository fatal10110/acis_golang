  S ActionFailed
  S NpcHtmlMessage obj=kluck item=0 page=warehouse/30895.htm
  S ActionFailed
bypass npc_{kluck}_Quest
  S NpcHtmlMessage obj=kluck item=0 page=script/quest/Q354_ConquestOfAlligatorIsland/30895-03.htm
  S ActionFailed
  S ActionFailed
bypass Quest Q354_ConquestOfAlligatorIsland 30895-04.htm
  S NpcHtmlMessage obj=kluck item=0 page=script/quest/Q354_ConquestOfAlligatorIsland/30895-04.htm
  S ActionFailed
bypass Quest Q354_ConquestOfAlligatorIsland 30895-03.htm
  S NpcHtmlMessage obj=kluck item=0 page=script/quest/Q354_ConquestOfAlligatorIsland/30895-03.htm
  S ActionFailed
bypass Quest Q354_ConquestOfAlligatorIsland 30895-05.htm
  S NpcHtmlMessage obj=kluck item=0 page=script/quest/Q354_ConquestOfAlligatorIsland/30895-05.htm
  S ActionFailed
  items 57=0

# Two lads: a tooth and a fragment each.
kill crokian x2
  S SystemMessage id=95 1:0 1:0
  S SystemMessage id=54 3:5863
  S SystemMessage id=54 3:5864
  S PlaySound type=0 file=ItemSound.quest_itemget bind=0 obj=0 loc=0,0,0 delay=0
