  S NpcHtmlMessage obj=pinter item=0 page=trainer/30298.htm
  S ActionFailed
bypass npc_{pinter}_Quest
  S NpcHtmlMessage obj=pinter item=0 page=script/quest/Q118_ToLeadAndBeLed/30298-09.htm
