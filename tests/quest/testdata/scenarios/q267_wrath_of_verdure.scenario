# Wrath of Verdure (Q267): an elven fighter of level 4 accepts at Bremec; three goblin raiders give
# three goblin clubs (every roll pinned to succeed); Bremec pays a silvery leaf for each club, then
# the player quits the repeatable quest; then relog. Expectations replay the reference trace of this
# scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q267_wrath_of_verdure.golden
character Verdure 4
class 18
random always 0
script quest.Q267_WrathOfVerdure
item 1335 1340
page default/31853.htm
page script/quest/Q267_WrathOfVerdure/
npc bremec 31853 Folk 10 0 0
npc goblin 20325 Monster 40 0 0

# Bremec: accept.
action bremec
action bremec
  S ActionFailed
  S NpcHtmlMessage obj=bremec item=0 page=default/31853.htm
  S ActionFailed
bypass npc_{bremec}_Quest
  S NpcHtmlMessage obj=bremec item=0 page=script/quest/Q267_WrathOfVerdure/31853-02.htm
  S ActionFailed
  S ActionFailed
  state Q267_WrathOfVerdure CREATED
bypass Quest Q267_WrathOfVerdure 31853-03.htm
  S QuestList 267:0x80000001
  S ExShowQuestMark quest=267
  S PlaySound type=0 file=ItemSound.quest_accept bind=0 obj=0 loc=0,0,0 delay=0
  S NpcHtmlMessage obj=bremec item=0 page=script/quest/Q267_WrathOfVerdure/31853-03.htm
  S ActionFailed
  Q upsert Q267_WrathOfVerdure | <state> | STARTED
  Q upsert Q267_WrathOfVerdure | <cond> | 1
  state Q267_WrathOfVerdure STARTED
  rows Q267_WrathOfVerdure <cond>=1 <state>=STARTED

# Bremec: no club yet.
action bremec
  S ActionFailed
  S NpcHtmlMessage obj=bremec item=0 page=default/31853.htm
  S ActionFailed
bypass npc_{bremec}_Quest
  S NpcHtmlMessage obj=bremec item=0 page=script/quest/Q267_WrathOfVerdure/31853-04.htm
  S ActionFailed
  S ActionFailed

# Three goblin raiders: a club each.
kill goblin x3
  S SystemMessage id=95 1:0 1:0
  S SystemMessage id=54 3:1335
  S PlaySound type=0 file=ItemSound.quest_itemget bind=0 obj=0 loc=0,0,0 delay=0
  S SystemMessage id=95 1:0 1:0
  S SystemMessage id=54 3:1335
  S PlaySound type=0 file=ItemSound.quest_itemget bind=0 obj=0 loc=0,0,0 delay=0
  S SystemMessage id=95 1:0 1:0
  S SystemMessage id=54 3:1335
  S PlaySound type=0 file=ItemSound.quest_itemget bind=0 obj=0 loc=0,0,0 delay=0
  items 1335=3

# Bremec: three silvery leaves for the three clubs; then quit.
action bremec
  S ActionFailed
  S NpcHtmlMessage obj=bremec item=0 page=default/31853.htm
  S ActionFailed
bypass npc_{bremec}_Quest
  S SystemMessage id=301 3:1335 6:3
  S SystemMessage id=53 3:1340 6:3
  S NpcHtmlMessage obj=bremec item=0 page=script/quest/Q267_WrathOfVerdure/31853-05.htm
  S ActionFailed
  S ActionFailed
  items 1335=0 1340=3
bypass Quest Q267_WrathOfVerdure 31853-06.htm
  S PlaySound type=0 file=ItemSound.quest_finish bind=0 obj=0 loc=0,0,0 delay=0
  S QuestList
  S NpcHtmlMessage obj=bremec item=0 page=script/quest/Q267_WrathOfVerdure/31853-06.htm
  S ActionFailed
  Q delete-quest Q267_WrathOfVerdure
  state Q267_WrathOfVerdure -
  rows Q267_WrathOfVerdure -

# Relog: the quest is gone, and what it paid stays.
relog
  state Q267_WrathOfVerdure -
  rows Q267_WrathOfVerdure -
  items 1340=3
