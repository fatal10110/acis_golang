# The Guard Is Busy (Q257): a human fighter of level 6 accepts at Gilbert (a guard) with his
# mark; an orc archer gives an amulet, an orc fighter a necklace and a werewolf a fang (every roll
# pinned to succeed). Gilbert pays 10 per amulet and 20 per necklace or fang, and, the first time
# only, 6000 beginner soulshots with the tutorial voice. A second payment gives no shots; then
# the player quits the repeatable quest, giving back the mark; then relog. Expectations replay the reference trace of this scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q257_the_guard_is_busy.golden
character Guardsman 6
random always 0
script quest.Q257_TheGuardIsBusy
item 1084 752 1085 1086 5789
page guard/30039.htm
page script/quest/Q257_TheGuardIsBusy/
npc gilbert 30039 Guard 10 0 0
npc archer 20006 Monster 40 0 0
npc fighter 20093 Monster 0 40 0
npc werewolf 20132 Monster -40 0 0

# Gilbert: accept with his mark.
action gilbert
action gilbert
  S ActionFailed
  S NpcHtmlMessage obj=gilbert item=0 page=guard/30039.htm
  S ActionFailed
bypass npc_{gilbert}_Quest
  S NpcHtmlMessage obj=gilbert item=0 page=script/quest/Q257_TheGuardIsBusy/30039-02.htm
  S ActionFailed
  S ActionFailed
  state Q257_TheGuardIsBusy CREATED
bypass Quest Q257_TheGuardIsBusy 30039-03.htm
  S QuestList 257:0x80000001
  S ExShowQuestMark quest=257
  S PlaySound type=0 file=ItemSound.quest_accept bind=0 obj=0 loc=0,0,0 delay=0
  S SystemMessage id=54 3:1084
  S NpcHtmlMessage obj=gilbert item=0 page=script/quest/Q257_TheGuardIsBusy/30039-03.htm
  S ActionFailed
  Q upsert Q257_TheGuardIsBusy | <state> | STARTED
  Q upsert Q257_TheGuardIsBusy | <cond> | 1
  state Q257_TheGuardIsBusy STARTED
  rows Q257_TheGuardIsBusy <cond>=1 <state>=STARTED
  items 1084=1

# Nothing to pay for yet.
action gilbert
  S ActionFailed
  S NpcHtmlMessage obj=gilbert item=0 page=guard/30039.htm
  S ActionFailed
bypass npc_{gilbert}_Quest
  S NpcHtmlMessage obj=gilbert item=0 page=script/quest/Q257_TheGuardIsBusy/30039-04.htm
  S ActionFailed
  S ActionFailed

# An amulet, a necklace and a fang.
kill archer
  S SystemMessage id=95 1:0 1:0
  S SystemMessage id=54 3:752
  S PlaySound type=0 file=ItemSound.quest_itemget bind=0 obj=0 loc=0,0,0 delay=0
  items 752=1
kill fighter
  S SystemMessage id=95 1:0 1:0
  S SystemMessage id=54 3:1085
  S PlaySound type=0 file=ItemSound.quest_itemget bind=0 obj=0 loc=0,0,0 delay=0
  items 1085=1
kill werewolf
  S SystemMessage id=95 1:0 1:0
  S SystemMessage id=54 3:1086
  S PlaySound type=0 file=ItemSound.quest_itemget bind=0 obj=0 loc=0,0,0 delay=0
  items 1086=1

# First payment: 10 + 20 + 20, then the beginner soulshots of a fighter.
action gilbert
  S ActionFailed
  S NpcHtmlMessage obj=gilbert item=0 page=guard/30039.htm
  S ActionFailed
bypass npc_{gilbert}_Quest
  S SystemMessage id=302 3:752
  S SystemMessage id=302 3:1085
  S SystemMessage id=302 3:1086
  S SystemMessage id=52 6:50
  S TutorialShowQuestionMark id=26
  S SystemMessage id=53 3:5789 6:6000
  S PlaySound type=2 file=tutorial_voice_026 bind=1 obj=player loc=10,20,30 delay=0
  S NpcHtmlMessage obj=gilbert item=0 page=script/quest/Q257_TheGuardIsBusy/30039-07.htm
  S ActionFailed
  S ActionFailed
  M set Q257_TheGuardIsBusy_OneTimeQuestFlag | true
  items 57=50 752=0 1085=0 1086=0 5789=6000

# Second payment: one more fang, and no shots this time.
kill werewolf
  S SystemMessage id=95 1:0 1:0
  S SystemMessage id=54 3:1086
  S PlaySound type=0 file=ItemSound.quest_itemget bind=0 obj=0 loc=0,0,0 delay=0
  items 1086=1
action gilbert
  S ActionFailed
  S NpcHtmlMessage obj=gilbert item=0 page=guard/30039.htm
  S ActionFailed
bypass npc_{gilbert}_Quest
  S SystemMessage id=302 3:1086
  S SystemMessage id=52 6:20
  S NpcHtmlMessage obj=gilbert item=0 page=script/quest/Q257_TheGuardIsBusy/30039-07.htm
  S ActionFailed
  S ActionFailed
  items 57=70 1086=0 5789=6000

# Quit: the mark goes back.
bypass Quest Q257_TheGuardIsBusy 30039-05.htm
  S SystemMessage id=302 3:1084
  S PlaySound type=0 file=ItemSound.quest_finish bind=0 obj=0 loc=0,0,0 delay=0
  S QuestList
  S NpcHtmlMessage obj=gilbert item=0 page=script/quest/Q257_TheGuardIsBusy/30039-05.htm
  S ActionFailed
  Q delete-quest Q257_TheGuardIsBusy
  items 1084=0
  state Q257_TheGuardIsBusy -
  rows Q257_TheGuardIsBusy -

# Relog: the quest is gone, and what it paid stays.
relog
  state Q257_TheGuardIsBusy -
  rows Q257_TheGuardIsBusy -
  items 57=70 5789=6000 1084=0
