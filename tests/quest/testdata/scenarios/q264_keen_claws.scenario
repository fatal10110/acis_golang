  S SystemMessage id=95 1:0 1:0
  S SystemMessage id=53 3:1367 6:2
  S PlaySound type=0 file=ItemSound.quest_itemget bind=0 obj=0 loc=0,0,0 delay=0
  items 1367=2
kill wolf
  S SystemMessage id=95 1:0 1:0
  S SystemMessage id=54 3:1367
  S PlaySound type=0 file=ItemSound.quest_itemget bind=0 obj=0 loc=0,0,0 delay=0
  items 1367=3
action payne
  S ActionFailed
  S NpcHtmlMessage obj=payne item=0 page=merchant/30136.htm
  S ActionFailed
bypass npc_{payne}_Quest
  S NpcHtmlMessage obj=payne item=0 page=script/quest/Q264_KeenClaws/30136-04.htm
