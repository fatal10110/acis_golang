  S NpcHtmlMessage obj=payne item=0 page=script/quest/Q264_KeenClaws/30136-03.htm
  S ActionFailed
  Q upsert Q264_KeenClaws | <state> | STARTED
  Q upsert Q264_KeenClaws | <cond> | 1
  state Q264_KeenClaws STARTED
  rows Q264_KeenClaws <cond>=1 <state>=STARTED

# A goblin (two claws) and an ashen wolf (one).
