# Keen Claws (Q264): a level 3 character accepts at Payne (a merchant); goblins give two claws
# each and ashen wolves one (every roll pinned to succeed), the fiftieth claw moving the quest on;
# Payne takes them and rolls the reward, here pinned to the jackpot wooden helmet, and the
# repeatable quest ends; then relog. Expectations replay the reference trace of this scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q264_keen_claws.golden
character Clawer 3
random always 0
script quest.Q264_KeenClaws
item 1367 36 43 462 1061 48 35
page merchant/30136.htm
page script/quest/Q264_KeenClaws/
npc payne 30136 Merchant 10 0 0
npc goblin 20003 Monster 40 0 0
npc wolf 20456 Monster 0 40 0

# Payne: accept.
action payne
action payne
  S ActionFailed
  S NpcHtmlMessage obj=payne item=0 page=merchant/30136.htm
  S ActionFailed
bypass npc_{payne}_Quest
  S NpcHtmlMessage obj=payne item=0 page=script/quest/Q264_KeenClaws/30136-02.htm
  S ActionFailed
  S ActionFailed
  state Q264_KeenClaws CREATED
bypass Quest Q264_KeenClaws 30136-03.htm
  S QuestList 264:0x80000001
  S ExShowQuestMark quest=264
