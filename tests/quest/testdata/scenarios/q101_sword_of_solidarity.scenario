# Sword of Solidarity (Q101): a human fighter of level 9 accepts at Roien, carries his letter to
# Altran, kills two Tunath orc marksmen for the top and bottom of a broken blade (every roll
# pinned to succeed), brings Altran's note back to Roien and the sword handle to Altran, who
# gives the Sword of Solidarity, the newbie soulshots and the echo crystals; then relog.
# Expectations replay the reference trace of this scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q101_sword_of_solidarity.golden
character Squire 9
random always 0
script quest.Q101_SwordOfSolidarity
item 739 740 741 796 937 742 738 1060 4412 4413 4414 4415 4416 5789
page default/30008.htm
page default/30283.htm
page script/quest/Q101_SwordOfSolidarity/
npc roien 30008 Folk 10 0 0
npc altran 30283 Folk 20 0 0
npc marksman 20361 Monster 40 0 0

# Roien: three pages, then accept.
action roien
action roien
  S ActionFailed
  S NpcHtmlMessage obj=roien item=0 page=default/30008.htm
  S ActionFailed
bypass npc_{roien}_Quest
  S NpcHtmlMessage obj=roien item=0 page=script/quest/Q101_SwordOfSolidarity/30008-02.htm
  S ActionFailed
  S ActionFailed
  state Q101_SwordOfSolidarity CREATED
bypass Quest Q101_SwordOfSolidarity 30008-02a.htm
  S NpcHtmlMessage obj=roien item=0 page=script/quest/Q101_SwordOfSolidarity/30008-02a.htm
