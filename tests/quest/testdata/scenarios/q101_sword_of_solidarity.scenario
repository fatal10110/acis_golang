  S SystemMessage id=54 3:796
  S NpcHtmlMessage obj=roien item=0 page=script/quest/Q101_SwordOfSolidarity/30008-03.htm
  S ActionFailed
  Q upsert Q101_SwordOfSolidarity | <state> | STARTED
  Q upsert Q101_SwordOfSolidarity | <cond> | 1
  items 796=1
  state Q101_SwordOfSolidarity STARTED
  rows Q101_SwordOfSolidarity <cond>=1 <state>=STARTED
action roien
  S ActionFailed
  S NpcHtmlMessage obj=roien item=0 page=default/30008.htm
  S ActionFailed
bypass npc_{roien}_Quest
  S NpcHtmlMessage obj=roien item=0 page=script/quest/Q101_SwordOfSolidarity/30008-04.htm
  S ActionFailed
  S ActionFailed

