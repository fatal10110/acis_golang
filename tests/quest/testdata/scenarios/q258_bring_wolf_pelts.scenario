# Bring Wolf Pelts (Q258): a level 3 character accepts at Lector (a merchant); forty wolves give
# forty pelts, the fortieth moving the quest on; Lector takes them and rolls the reward, here
# pinned to the jackpot cotton shirt, and the repeatable quest ends; then relog. Expectations replay the reference trace of this scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q258_bring_wolf_pelts.golden
character Pelter 3
random always 0
script quest.Q258_BringWolfPelts
item 702 390 29 22 1119 426
page merchant/30001.htm
page script/quest/Q258_BringWolfPelts/
npc lector 30001 Merchant 10 0 0
npc wolf 20120 Monster 40 0 0

# Lector: accept.
action lector
action lector
  S ActionFailed
  S NpcHtmlMessage obj=lector item=0 page=merchant/30001.htm
  S ActionFailed
bypass npc_{lector}_Quest
  S NpcHtmlMessage obj=lector item=0 page=script/quest/Q258_BringWolfPelts/30001-02.htm
  S ActionFailed
  S ActionFailed
  state Q258_BringWolfPelts CREATED
bypass Quest Q258_BringWolfPelts 30001-03.htm
  S QuestList 258:0x80000001
  S ExShowQuestMark quest=258
  S PlaySound type=0 file=ItemSound.quest_accept bind=0 obj=0 loc=0,0,0 delay=0
  S NpcHtmlMessage obj=lector item=0 page=script/quest/Q258_BringWolfPelts/30001-03.htm
  S ActionFailed
  Q upsert Q258_BringWolfPelts | <state> | STARTED
  Q upsert Q258_BringWolfPelts | <cond> | 1
  state Q258_BringWolfPelts STARTED
  rows Q258_BringWolfPelts <cond>=1 <state>=STARTED

