  S ExShowQuestMark quest=218
  S PlaySound type=0 file=ItemSound.quest_accept bind=0 obj=0 loc=0,0,0 delay=0
  S SystemMessage id=54 3:3141
  S SystemMessage id=53 3:7562 6:102
  S NpcHtmlMessage obj=cardien item=0 page=script/quest/Q218_TestimonyOfLife/30460-04a.htm
  S ActionFailed
  Q upsert Q218_TestimonyOfLife | <state> | STARTED
  Q upsert Q218_TestimonyOfLife | <cond> | 1
  M set secondClassChange37 | true
  items 3141=1 7562=102
  state Q218_TestimonyOfLife STARTED
  rows Q218_TestimonyOfLife <state>=STARTED <cond>=1
action cardien
  S ActionFailed
  S NpcHtmlMessage obj=cardien item=0 page=trainer/30460.htm
  S ActionFailed
bypass npc_{cardien}_Quest
  S NpcHtmlMessage obj=cardien item=0 page=script/quest/Q218_TestimonyOfLife/30460-05.htm
  S ActionFailed
  S ActionFailed

