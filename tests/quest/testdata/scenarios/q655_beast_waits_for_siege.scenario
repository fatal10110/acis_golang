# A Grand Plan for Taming Wild Beasts (Q655), registrations open: until the Wild Beast Reserve (hall 63) waits for its battle the messenger answers even a leader with the stored next siege date.
# Expectations replay the reference trace of this scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q655_beast_waits_for_siege.golden
character Leader 40
clan 4
hall 63 registering date 4102444800000
script quest.Q655_AGrandPlanForTamingWildBeasts
script script.siegablehall.WildBeastReserve
item 8084 8293
page script/quest/Q655_AGrandPlanForTamingWildBeasts/
page script/siegablehall/WildBeastReserve/
npc messenger 35627 Folk 10 0 0

action messenger
action messenger
  S ActionFailed
  S NpcHtmlMessage obj=messenger item=0 page=script/siegablehall/WildBeastReserve/farm_messenger002.htm
  S ActionFailed
bypass npc_{messenger}_Quest
  S NpcHtmlMessage obj=messenger item=0 html="<html><body>Messenger:<br>\nRegistration begins an hour before the Clan Hall War.<br>\nAs far as I know, the next Clan Hall War is around 2100-01-01 00:00:00. Check back then.\n</body></html>\n"
  S ActionFailed
  S ActionFailed
  state Q655_AGrandPlanForTamingWildBeasts CREATED
