# Black Swan (Q351): a level 32 character accepts at Gosta and gets his order; Roman has no
# business yet; Heine has nothing to buy; two Tasaba lizardmen give a fang and a barrel each (every
# roll pinned to succeed); Heine buys the fangs, then the barrels for adena and bills (cond 2);
# Roman sees the bills; with neither item left Heine ends the quest; then relog. Expectations
# replay the reference trace of this scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q351_black_swan.golden
character Swan 32
random always 0
script quest.Q351_BlackSwan
item 57 4296 4297 4298 4310
page guard/30916.htm
page default/30969.htm
page villagemaster/30897.htm
page script/quest/Q351_BlackSwan/
npc gosta 30916 Guard 10 0 0
npc iason 30969 Folk -10 0 0
npc roman 30897 VillageMasterDwarf 0 10 0
npc lizard 20784 Monster 40 0 0

# Gosta: accept through 30916-02.
action gosta
action gosta
  S ActionFailed
  S NpcHtmlMessage obj=gosta item=0 page=guard/30916.htm
  S ActionFailed
bypass npc_{gosta}_Quest
  S NpcHtmlMessage obj=gosta item=0 page=script/quest/Q351_BlackSwan/30916-01.htm
