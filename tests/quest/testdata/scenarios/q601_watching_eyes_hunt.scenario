# Watching Eyes (Q601): with 99 proofs, a Disciple kill gives the 100th (every roll pinned to
# succeed) and moves the quest to the second stage. Expectations replay the reference trace of this
# scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q601_watching_eyes_hunt.golden
character Hero 72
quest Q601_WatchingEyes <cond>=1 <state>=STARTED
hold 7188 99
random always 0
script quest.Q601_WatchingEyes
item 7188 6699 6698 6700 57
page default/31683.htm
page script/quest/Q601_WatchingEyes/
npc eye 31683 Folk 10 0 0
npc disciple 21306 Monster 40 0 0

# 99 proofs: not yet.
action eye
action eye
  S ActionFailed
  S NpcHtmlMessage obj=eye item=0 page=default/31683.htm
  S ActionFailed
bypass npc_{eye}_Quest
  S NpcHtmlMessage obj=eye item=0 page=script/quest/Q601_WatchingEyes/31683-05.htm
  S ActionFailed
  S ActionFailed
kill disciple
  S SystemMessage id=95 1:0 1:0
  S SystemMessage id=54 3:7188
  S PlaySound type=0 file=ItemSound.quest_middle bind=0 obj=0 loc=0,0,0 delay=0
  S QuestList 601:0x80000003
  S ExShowQuestMark quest=601
  Q upsert Q601_WatchingEyes | <cond> | 2
  items 7188=100
  rows Q601_WatchingEyes <cond>=2 <state>=STARTED
  state Q601_WatchingEyes STARTED
action eye
  S ActionFailed
  S NpcHtmlMessage obj=eye item=0 page=default/31683.htm
  S ActionFailed
action eye
  S ActionFailed
  S NpcHtmlMessage obj=eye item=0 page=default/31683.htm
  S ActionFailed
bypass npc_{eye}_Quest
  S NpcHtmlMessage obj=eye item=0 page=script/quest/Q601_WatchingEyes/31683-06.htm
  S ActionFailed
  S ActionFailed
