# Millennium Love (Q156): a level 15 character accepts at Lilith with her letter; Baenedes
# answers it with Theon's diary, and Lilith takes the diary for a reward and experience; then
# relog. Baenedes keeping the letter is q156_millennium_love_baenedes.scenario. Expectations replay the reference trace of this scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q156_millennium_love.golden
character Lover 15
script quest.Q156_MillenniumLove
item 1022 1023 5250
page default/30368.htm
page trainer/30369.htm
page script/quest/Q156_MillenniumLove/
npc lilith 30368 Folk 10 0 0
npc baenedes 30369 Trainer 20 0 0

# Lilith: three pages, then accept with her letter.
action lilith
action lilith
  S ActionFailed
  S NpcHtmlMessage obj=lilith item=0 page=default/30368.htm
  S ActionFailed
bypass npc_{lilith}_Quest
  S NpcHtmlMessage obj=lilith item=0 page=script/quest/Q156_MillenniumLove/30368-01.htm
  S ActionFailed
  S ActionFailed
  state Q156_MillenniumLove CREATED
bypass Quest Q156_MillenniumLove 30368-02.htm
  S NpcHtmlMessage obj=lilith item=0 page=script/quest/Q156_MillenniumLove/30368-02.htm
  S ActionFailed
bypass Quest Q156_MillenniumLove 30368-03.htm
  S NpcHtmlMessage obj=lilith item=0 page=script/quest/Q156_MillenniumLove/30368-03.htm
  S ActionFailed
bypass Quest Q156_MillenniumLove 30368-04.htm
  S QuestList 156:0x80000001
  S ExShowQuestMark quest=156
  S PlaySound type=0 file=ItemSound.quest_accept bind=0 obj=0 loc=0,0,0 delay=0
  S SystemMessage id=54 3:1022
  S NpcHtmlMessage obj=lilith item=0 page=script/quest/Q156_MillenniumLove/30368-04.htm
  S ActionFailed
  Q upsert Q156_MillenniumLove | <state> | STARTED
  Q upsert Q156_MillenniumLove | <cond> | 1
  state Q156_MillenniumLove STARTED
  rows Q156_MillenniumLove <cond>=1 <state>=STARTED
  items 1022=1
action lilith
  S ActionFailed
  S NpcHtmlMessage obj=lilith item=0 page=default/30368.htm
  S ActionFailed
bypass npc_{lilith}_Quest
  S NpcHtmlMessage obj=lilith item=0 page=script/quest/Q156_MillenniumLove/30368-05.htm
  S ActionFailed
  S ActionFailed

# Baenedes: the letter for Theon's diary.
action baenedes
action baenedes
  S ActionFailed
  S NpcHtmlMessage obj=baenedes item=0 page=trainer/30369.htm
  S ActionFailed
bypass npc_{baenedes}_Quest
  S NpcHtmlMessage obj=baenedes item=0 page=script/quest/Q156_MillenniumLove/30369-01.htm
  S ActionFailed
  S ActionFailed
bypass Quest Q156_MillenniumLove 30369-02.htm
  S QuestList 156:0x80000003
  S ExShowQuestMark quest=156
  S PlaySound type=0 file=ItemSound.quest_middle bind=0 obj=0 loc=0,0,0 delay=0
  S SystemMessage id=302 3:1022
  S SystemMessage id=54 3:1023
  S NpcHtmlMessage obj=baenedes item=0 page=script/quest/Q156_MillenniumLove/30369-02.htm
  S ActionFailed
  Q upsert Q156_MillenniumLove | <cond> | 2
  items 1022=0 1023=1
  rows Q156_MillenniumLove <cond>=2 <state>=STARTED
action baenedes
  S ActionFailed
  S NpcHtmlMessage obj=baenedes item=0 page=trainer/30369.htm
  S ActionFailed
bypass npc_{baenedes}_Quest
  S NpcHtmlMessage obj=baenedes item=0 page=script/quest/Q156_MillenniumLove/30369-04.htm
  S ActionFailed
  S ActionFailed

# Lilith: the diary for her reward; the quest completes.
action lilith
action lilith
  S ActionFailed
  S NpcHtmlMessage obj=lilith item=0 page=default/30368.htm
  S ActionFailed
bypass npc_{lilith}_Quest
  S SystemMessage id=302 3:1023
  S SystemMessage id=54 3:5250
  S SystemMessage id=45 1:3000
  S PlaySound type=0 file=ItemSound.quest_finish bind=0 obj=0 loc=0,0,0 delay=0
  S QuestList 156:0x00000000
  S NpcHtmlMessage obj=lilith item=0 page=script/quest/Q156_MillenniumLove/30368-06.htm
  S ActionFailed
  S ActionFailed
  Q upsert Q156_MillenniumLove | <state> | COMPLETED
  Q delete-except-state Q156_MillenniumLove
  items 1023=0 5250=1
  state Q156_MillenniumLove COMPLETED
  rows Q156_MillenniumLove <state>=COMPLETED

# Relog: the completed quest loads from its one row, and the reward stays.
relog
  state Q156_MillenniumLove COMPLETED
  rows Q156_MillenniumLove <state>=COMPLETED
  items 5250=1
action lilith
action lilith
  S ActionFailed
  S NpcHtmlMessage obj=lilith item=0 page=default/30368.htm
  S ActionFailed
bypass npc_{lilith}_Quest
  S NpcHtmlMessage obj=lilith item=0 html="<html><body>This quest has already been completed.</body></html>"
  S ActionFailed
  S ActionFailed
