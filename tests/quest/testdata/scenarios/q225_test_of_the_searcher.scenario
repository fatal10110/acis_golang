npc alex 30291 Guard -10 0 0
npc leirynn 30728 Folk 0 10 0
npc borys 30729 Folk 0 -10 0
npc tyra 30420 Merchant 10 10 0
npc jax 30730 Folk -10 10 0
npc tree 30627 Folk 10 -10 0
npc chest 30628 Folk -10 -10 0
npc deluShaman 20781 Monster 40 0 0
npc kalkis 27093 Monster -40 0 0
npc neer 27092 Monster 0 40 0
npc fungus 20555 Monster 0 -40 0
npc scavenger 20551 Monster 40 40 0
npc hangman 20144 Monster -40 40 0

