# Pavel the Giant (Q121), refused: a level 45 character, one short of the quest's level, is turned
# away by Newyear and the quest is not started. Expectations replay the reference trace of this scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q121_pavel_the_giant_low_level.golden
character Giant 45
script quest.Q121_PavelTheGiant
item 57
page villagemaster/31961.htm
page script/quest/Q121_PavelTheGiant/
npc newyear 31961 VillageMasterDwarf 10 0 0

action newyear
action newyear
  S ActionFailed
  S NpcHtmlMessage obj=newyear item=0 page=villagemaster/31961.htm
  S ActionFailed
bypass npc_{newyear}_Quest
  S NpcHtmlMessage obj=newyear item=0 page=script/quest/Q121_PavelTheGiant/31961-1a.htm
  S ActionFailed
  S ActionFailed
  state Q121_PavelTheGiant CREATED
  rows Q121_PavelTheGiant -
