# Help the Sister! (Q043): a level 26 character holding the crafted dagger and 29 map pieces accepts at Cooper, who takes the
# crafted dagger. One specter brings the thirtieth piece (the cond moves); Cooper trades the pieces for the whole one,
# which Galladucci takes; Cooper pays with a pet ticket and the quest completes; then relog. Every script
# roll is pinned to 0.
# Not traced (#4105): the starter's page lists multisell 101, the Go run's player object id, which
# the Go render names {player}. Played with its trace line, the reference trace matched every step;
# the starter's page lines below are that page with 101 written as {player}.
character Helper 26
hold 220 1
hold 7550 29
random always 0
script quest.Q043_HelpTheSister
item 220 7550 7551 7584
page merchant/30829.htm
page merchant/30097.htm
page script/quest/Q043_HelpTheSister/
npc cooper 30829 Merchant 10 0 0
npc galladucci 30097 Merchant -10 0 0
npc mob 20171 Monster 0 40 0

# Cooper: accept.
action cooper
action cooper
  S ActionFailed
  S NpcHtmlMessage obj=cooper item=0 html="<html><body>Pet Manager Cooper:<br>\nWelcome to the Pet Kennel of Giran Castle Town. This location is good for business but bad for the pets. I hope to move the shop to a quieter location in the country sometime in the future.<br>\n<a action=\"bypass -h npc_{cooper}_Buy 92\">Buy a pet product</a><br>\n<a action=\"bypass -h npc_{cooper}_exc_multisell 1000\">Upgrade Pet Equipment</a><br>\n<a action=\"bypass -h npc_{cooper}_multisell 999\">Exchange the hatchling equipment with the strider equipment</a><br>\n<a action=\"bypass -h npc_{cooper}_multisell {player}\">Exchange the pet trade ticket with a pet</a><br>\n<a action=\"bypass -h npc_{cooper}_Sell\">Sell your item</a><br>\n<a action=\"bypass -h npc_{cooper}_TerritoryStatus\">See the lord and get the tax rate information</a><br>\n<a action=\"bypass -h npc_{cooper}_Quest\">Quest</a>\n</body></html>\n"
  S ActionFailed
bypass npc_{cooper}_Quest
  S NpcHtmlMessage obj=cooper item=0 page=script/quest/Q043_HelpTheSister/30829-00.htm
  S ActionFailed
  S ActionFailed
  state Q043_HelpTheSister CREATED
bypass Quest Q043_HelpTheSister 30829-01.htm
  S QuestList 43:0x80000001
  S ExShowQuestMark quest=43
  S PlaySound type=0 file=ItemSound.quest_accept bind=0 obj=0 loc=0,0,0 delay=0
  S NpcHtmlMessage obj=cooper item=0 page=script/quest/Q043_HelpTheSister/30829-01.htm
  S ActionFailed
  Q upsert Q043_HelpTheSister | <state> | STARTED
  Q upsert Q043_HelpTheSister | <cond> | 1
  state Q043_HelpTheSister STARTED
  rows Q043_HelpTheSister <cond>=1 <state>=STARTED

# Cooper takes the crafted dagger.
action cooper
  S ActionFailed
  S NpcHtmlMessage obj=cooper item=0 html="<html><body>Pet Manager Cooper:<br>\nWelcome to the Pet Kennel of Giran Castle Town. This location is good for business but bad for the pets. I hope to move the shop to a quieter location in the country sometime in the future.<br>\n<a action=\"bypass -h npc_{cooper}_Buy 92\">Buy a pet product</a><br>\n<a action=\"bypass -h npc_{cooper}_exc_multisell 1000\">Upgrade Pet Equipment</a><br>\n<a action=\"bypass -h npc_{cooper}_multisell 999\">Exchange the hatchling equipment with the strider equipment</a><br>\n<a action=\"bypass -h npc_{cooper}_multisell {player}\">Exchange the pet trade ticket with a pet</a><br>\n<a action=\"bypass -h npc_{cooper}_Sell\">Sell your item</a><br>\n<a action=\"bypass -h npc_{cooper}_TerritoryStatus\">See the lord and get the tax rate information</a><br>\n<a action=\"bypass -h npc_{cooper}_Quest\">Quest</a>\n</body></html>\n"
