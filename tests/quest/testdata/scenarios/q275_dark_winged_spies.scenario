# Dark Winged Spies (Q275): an orc fighter of level 11 holding a Varangka parasite accepts at
# Tantus; the Varangka's tracker takes the parasite and gives five fangs (a drop that cannot
# miss), and a second tracker, the parasite gone, gives none; sixty-five Darkwing bats give a fang
# each, the seventieth fang moving the quest on (the tracker's call pinned off, its roll at 50:
# the call is a Boot test, as a scenario cannot show a script-spawned NPC, #4020 item 5); Tantus
# pays 4200 adena and the repeatable quest ends; then relog. Expectations replay the reference
# trace of this scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q275_dark_winged_spies.golden
character Spy 11
class 44
hold 1479 1
random 0 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0 50 0
script quest.Q275_DarkWingedSpies
item 1478 1479
page default/30567.htm
page script/quest/Q275_DarkWingedSpies/
npc tantus 30567 Folk 10 0 0
npc bat 20316 Monster 40 0 0
npc tracker 27043 Monster 0 40 0

# Tantus: accept.
action tantus
action tantus
  S ActionFailed
  S NpcHtmlMessage obj=tantus item=0 page=default/30567.htm
  S ActionFailed
bypass npc_{tantus}_Quest
  S NpcHtmlMessage obj=tantus item=0 page=script/quest/Q275_DarkWingedSpies/30567-02.htm
  S ActionFailed
  S ActionFailed
  state Q275_DarkWingedSpies CREATED
bypass Quest Q275_DarkWingedSpies 30567-03.htm
  S QuestList 275:0x80000001
  S ExShowQuestMark quest=275
  S PlaySound type=0 file=ItemSound.quest_accept bind=0 obj=0 loc=0,0,0 delay=0
  S NpcHtmlMessage obj=tantus item=0 page=script/quest/Q275_DarkWingedSpies/30567-03.htm
  S ActionFailed
  Q upsert Q275_DarkWingedSpies | <state> | STARTED
  Q upsert Q275_DarkWingedSpies | <cond> | 1
  state Q275_DarkWingedSpies STARTED
  rows Q275_DarkWingedSpies <cond>=1 <state>=STARTED

# The tracker: the parasite for five fangs; a second one gives nothing.
kill tracker
  S SystemMessage id=95 1:0 1:0
  S SystemMessage id=302 3:1479
  S SystemMessage id=53 3:1478 6:5
  S PlaySound type=0 file=ItemSound.quest_itemget bind=0 obj=0 loc=0,0,0 delay=0
  items 1478=5 1479=0
kill tracker
  S SystemMessage id=95 1:0 1:0
  items 1478=5 1479=0

# Tantus: not yet.
action tantus
  S ActionFailed
  S NpcHtmlMessage obj=tantus item=0 page=default/30567.htm
  S ActionFailed
bypass npc_{tantus}_Quest
  S NpcHtmlMessage obj=tantus item=0 page=script/quest/Q275_DarkWingedSpies/30567-04.htm
  S ActionFailed
  S ActionFailed

# Sixty-four bats, then the sixty-fifth brings the seventieth fang.
kill bat x64
