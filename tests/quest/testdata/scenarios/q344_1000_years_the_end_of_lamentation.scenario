  S ActionFailed
bypass Quest Q344_1000YearsTheEndOfLamentation 30754-04.htm
  S QuestList 344:0x80000001
  S ExShowQuestMark quest=344
  S PlaySound type=0 file=ItemSound.quest_accept bind=0 obj=0 loc=0,0,0 delay=0
  S NpcHtmlMessage obj=gilmore item=0 page=script/quest/Q344_1000YearsTheEndOfLamentation/30754-04.htm
  S ActionFailed
  Q upsert Q344_1000YearsTheEndOfLamentation | <state> | STARTED
  Q upsert Q344_1000YearsTheEndOfLamentation | <cond> | 1
  state Q344_1000YearsTheEndOfLamentation STARTED
  rows Q344_1000YearsTheEndOfLamentation <cond>=1 <state>=STARTED

# No article yet.
action gilmore
  S ActionFailed
  S NpcHtmlMessage obj=gilmore item=0 page=default/30754.htm
  S ActionFailed
bypass npc_{gilmore}_Quest
  S NpcHtmlMessage obj=gilmore item=0 page=script/quest/Q344_1000YearsTheEndOfLamentation/30754-09.htm
