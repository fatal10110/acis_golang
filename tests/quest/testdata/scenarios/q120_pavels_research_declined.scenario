# Pavel's Research (Q120), declined: a level 50 character that finished Resurrection of an Old
# Manager (Q114, a stub here, its journal seeded) reads the stones' offer and declines; the quest
# was never started, so the decline's exit leaves it as it is, with no rows. Expectations replay
# the reference trace of this scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q120_pavels_research_declined.golden
character Researcher 50
quest Q114_ResurrectionOfAnOldManager <state>=COMPLETED
stub quest.Q114_ResurrectionOfAnOldManager
script quest.Q120_PavelsResearch
item 8058 8059 8060 8290 8291 8292 854
page default/32046.htm
page script/quest/Q120_PavelsResearch/
npc stones 32046 Folk 10 0 0

action stones
action stones
  S ActionFailed
  S NpcHtmlMessage obj=stones item=0 page=default/32046.htm
  S ActionFailed
bypass npc_{stones}_Quest
  S NpcHtmlMessage obj=stones item=0 html="<html><body><a action=\"bypass -h npc_{stones}_Quest Q114_ResurrectionOfAnOldManager\">[Resurrection of an Old Manager (Done)]</a><br><a action=\"bypass -h npc_{stones}_Quest Q120_PavelsResearch\">[Pavel's Research]</a><br></body></html>"
  S ActionFailed
  S ActionFailed
bypass npc_{stones}_Quest Q120_PavelsResearch
  S NpcHtmlMessage obj=stones item=0 page=script/quest/Q120_PavelsResearch/32046-01.htm
  S ActionFailed
  S ActionFailed
  state Q120_PavelsResearch CREATED
bypass Quest Q120_PavelsResearch 32046-02.htm
  S NpcHtmlMessage obj=stones item=0 page=script/quest/Q120_PavelsResearch/32046-02.htm
  S ActionFailed
bypass Quest Q120_PavelsResearch 32046-03.htm
  S NpcHtmlMessage obj=stones item=0 page=script/quest/Q120_PavelsResearch/32046-03.htm
  S ActionFailed
bypass Quest Q120_PavelsResearch 32046-04.htm
  S NpcHtmlMessage obj=stones item=0 page=script/quest/Q120_PavelsResearch/32046-04.htm
  S ActionFailed
  state Q120_PavelsResearch CREATED
  rows Q120_PavelsResearch -
