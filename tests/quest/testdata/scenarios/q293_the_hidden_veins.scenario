  S NpcHtmlMessage obj=filaur item=0 page=script/quest/Q293_TheHiddenVeins/30535-03.htm
  S ActionFailed
  Q upsert Q293_TheHiddenVeins | <state> | STARTED
  Q upsert Q293_TheHiddenVeins | <cond> | 1
  state Q293_TheHiddenVeins STARTED
  rows Q293_TheHiddenVeins <cond>=1 <state>=STARTED

