# Wirphy: the starstones for two tokens; the quest ends.
action wirphy
  S ActionFailed
  S NpcHtmlMessage obj=wirphy item=0 page=gatekeeper/30540.htm
  S ActionFailed
bypass npc_{wirphy}_Quest
  S SystemMessage id=301 3:1573 6:20
  S SystemMessage id=53 3:1659 6:2
  S PlaySound type=0 file=ItemSound.quest_finish bind=0 obj=0 loc=0,0,0 delay=0
  S QuestList
  S NpcHtmlMessage obj=wirphy item=0 page=script/quest/Q297_GatekeepersFavor/30540-05.htm
