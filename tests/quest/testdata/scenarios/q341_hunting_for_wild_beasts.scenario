  S SystemMessage id=54 3:4259
  S PlaySound type=0 file=ItemSound.quest_middle bind=0 obj=0 loc=0,0,0 delay=0
  S SystemMessage id=95 1:0 1:0
  items 4259=20

# Pano: the skins for adena; the quest ends.
action pano
  S ActionFailed
  S NpcHtmlMessage obj=pano item=0 page=merchant/30078.htm
  S ActionFailed
bypass npc_{pano}_Quest
  S SystemMessage id=301 3:4259 6:20
  S SystemMessage id=52 6:3710
  S PlaySound type=0 file=ItemSound.quest_finish bind=0 obj=0 loc=0,0,0 delay=0
  S QuestList
  S NpcHtmlMessage obj=pano item=0 page=script/quest/Q341_HuntingForWildBeasts/30078-04.htm
  S ActionFailed
  S ActionFailed
  Q delete-quest Q341_HuntingForWildBeasts
  items 4259=0 57=3710
  state Q341_HuntingForWildBeasts -
  rows Q341_HuntingForWildBeasts -

# Relog: the quest is gone, and what it paid stays.
relog
  state Q341_HuntingForWildBeasts -
  rows Q341_HuntingForWildBeasts -
  items 57=3710
