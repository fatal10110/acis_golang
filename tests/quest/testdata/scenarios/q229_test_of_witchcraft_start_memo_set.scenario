# Q229_TestOfWitchcraft, start with the diamonds already paid: the character holds the secondClassChange39 memo, so the start event gives no
# Dimensional Diamonds (no item message, no memo write) and the accept page is the plain one, not the "a" page.
# Hand-written from the quest script (no reference trace).
character Witch 39
class 11
memo secondClassChange39 true
script quest.Q229_TestOfWitchcraft
item 3308 3309 3310 3311 3312 3313 3314 3315 3316 3317 3318 3319 3320 3321 3322 3323 3324 3325 3326 3327 3328 3329 3330 3331 3332 3333 3334 3335 3029 3307 7562
page default/30630.htm
page script/quest/Q229_TestOfWitchcraft/
npc orim 30630 Folk 10 0 0

action orim
action orim
  S ActionFailed
  S NpcHtmlMessage obj=orim item=0 page=default/30630.htm
  S ActionFailed
bypass npc_{orim}_Quest
  S NpcHtmlMessage obj=orim item=0 page=script/quest/Q229_TestOfWitchcraft/30630-03.htm
  S ActionFailed
  S ActionFailed
  state Q229_TestOfWitchcraft CREATED
  rows Q229_TestOfWitchcraft -
bypass Quest Q229_TestOfWitchcraft 30630-04.htm
  S NpcHtmlMessage obj=orim item=0 page=script/quest/Q229_TestOfWitchcraft/30630-04.htm
  S ActionFailed
  state Q229_TestOfWitchcraft CREATED
  rows Q229_TestOfWitchcraft -
bypass Quest Q229_TestOfWitchcraft 30630-07.htm
  S NpcHtmlMessage obj=orim item=0 page=script/quest/Q229_TestOfWitchcraft/30630-07.htm
  S ActionFailed
  state Q229_TestOfWitchcraft CREATED
  rows Q229_TestOfWitchcraft -
bypass Quest Q229_TestOfWitchcraft 30630-08.htm
  S QuestList 229:0x80000001
  S ExShowQuestMark quest=229
  S PlaySound type=0 file=ItemSound.quest_accept bind=0 obj=0 loc=0,0,0 delay=0
  S SystemMessage id=54 3:3308
  S NpcHtmlMessage obj=orim item=0 page=script/quest/Q229_TestOfWitchcraft/30630-08.htm
  S ActionFailed
  Q upsert Q229_TestOfWitchcraft | <state> | STARTED
  Q upsert Q229_TestOfWitchcraft | <cond> | 1
  items 3308=1 7562=0
  state Q229_TestOfWitchcraft STARTED
  rows Q229_TestOfWitchcraft <cond>=1 <state>=STARTED
