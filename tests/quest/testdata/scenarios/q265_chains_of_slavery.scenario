  S PlaySound type=0 file=ItemSound.quest_finish bind=0 obj=0 loc=0,0,0 delay=0
  S QuestList
  S NpcHtmlMessage obj=kristin item=0 page=script/quest/Q265_ChainsOfSlavery/30357-06.htm
