# First payment: 10 x 12 + 500, then the beginner spiritshots of a mystic.
action kristin
  S ActionFailed
  S NpcHtmlMessage obj=kristin item=0 page=guard/30357.htm
  S ActionFailed
bypass npc_{kristin}_Quest
  S SystemMessage id=301 3:1368 6:10
  S SystemMessage id=52 6:620
  S TutorialShowQuestionMark id=26
  S SystemMessage id=53 3:5790 6:3000
  S PlaySound type=2 file=tutorial_voice_027 bind=1 obj=player loc=10,20,30 delay=0
  S NpcHtmlMessage obj=kristin item=0 page=script/quest/Q265_ChainsOfSlavery/30357-05.htm
  S ActionFailed
  S ActionFailed
  M set Q265_ChainsOfSlavery_OneTimeQuestFlag | true
  items 1368=0 57=620 5790=3000

# An imp elder: one shackle, paid without shots.
kill elder
  S SystemMessage id=95 1:0 1:0
  S SystemMessage id=54 3:1368
  S PlaySound type=0 file=ItemSound.quest_itemget bind=0 obj=0 loc=0,0,0 delay=0
