# Path to an Artisan (Q418), Hitchi's cond-10 event: the datapack offers no link to 31963-04 (page 31963-01
# links only 31963-02 and 31963-06, and no other page of Hitchi links it), so a client cannot send it; the
# server drops the bypass and the quest stays on cond 9. Java sets cond 10 on that event (Q418.onAdvEvent),
# which is reachable only by a client that sends an unoffered link. Go-only: the reference probe's client
# does not send unoffered links either (#5081).
character Fighter 19
class 53
quest Q418_PathToAnArtisan <cond>=9 <state>=STARTED
hold 1633 1
hold 1634 1
hold 1641 1
script quest.Q418_PathToAnArtisan
item 1632 1633 1634 1635 1636 1637 1638 1639 1640 1641
page trainer/30527.htm
page trainer/30317.htm
page trainer/30298.htm
page default/32052.htm
page merchant/31963.htm
page default/30531.htm
page warehouse/31956.htm
page script/quest/Q418_PathToAnArtisan/
npc silvera 30527 Trainer 10 0 0
npc kluto 30317 Trainer -20 0 0
npc pinter 30298 Trainer 30 0 0
npc obi 32052 Folk -40 0 0
npc hitchi 31963 Merchant 50 0 0
npc lockirin 30531 Folk -60 0 0
npc rydel 31956 WarehouseKeeper 70 0 0
npc ratman 20389 Monster 40 0 0
npc leader 20390 Monster 50 0 0
npc thief 20017 Monster 60 0 0

action hitchi
action hitchi
  S ActionFailed
  S NpcHtmlMessage obj=hitchi item=0 page=merchant/31963.htm
  S ActionFailed
bypass npc_{hitchi}_Quest
  S NpcHtmlMessage obj=hitchi item=0 page=script/quest/Q418_PathToAnArtisan/31963-01.htm
  S ActionFailed
  S ActionFailed
# A link the page on screen does not offer: the server drops it, cond 9 stays.
bypass Quest Q418_PathToAnArtisan 31963-04.htm
  rejected
  rows Q418_PathToAnArtisan <cond>=9 <state>=STARTED
  state Q418_PathToAnArtisan STARTED
