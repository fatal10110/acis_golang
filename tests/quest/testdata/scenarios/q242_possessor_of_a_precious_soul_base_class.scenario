  S NpcHtmlMessage obj=virgil item=0 page=default/31742.htm
  S ActionFailed
bypass npc_{virgil}_Quest
  S NpcHtmlMessage obj=virgil item=0 page=script/quest/Q242_PossessorOfAPreciousSoul/31742-02.htm
