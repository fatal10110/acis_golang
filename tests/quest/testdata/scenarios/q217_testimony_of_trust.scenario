npc asterios 30154 VillageMasterPriest -10 0 0
npc thifiell 30358 VillageMasterDElf 0 10 0
npc clayton 30464 Trainer 0 -10 0
npc seresin 30657 Folk 20 20 0
npc kakai 30565 VillageMasterOrc -20 20 0
npc manakia 30515 Trainer 20 -20 0
npc lockirin 30531 Folk -20 -20 0
npc nikola 30621 Folk 30 0 0
npc biotin 30031 VillageMasterPriest -30 0 0
npc actea 27121 Monster 40 0 0
npc luell 27120 Monster -40 0 0
npc stakato 20157 Monster 0 40 0
npc ant 20082 Monster 0 -40 0
npc basilisk 20550 Monster 40 40 0
npc windsus 20553 Monster -40 40 0
npc porta 20213 Monster 40 -40 0


