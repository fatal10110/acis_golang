action anton
  S ActionFailed
  S NpcHtmlMessage obj=anton item=0 page=merchant/31338.htm
  S ActionFailed
bypass npc_{anton}_Quest
  S NpcHtmlMessage obj=anton item=0 page=script/quest/Q110_ToThePrimevalIsle/31338-01c.htm
  S ActionFailed
  S ActionFailed

# Marquez takes the book.
action marquez
action marquez
  S ActionFailed
  S NpcHtmlMessage obj=marquez item=0 page=default/32113.htm
  S ActionFailed
bypass npc_{marquez}_Quest
  S NpcHtmlMessage obj=marquez item=0 page=script/quest/Q110_ToThePrimevalIsle/32113-01.htm
