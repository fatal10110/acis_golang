# Black Swan (Q351), ten fangs: at cond 1 holding ten fangs and a barrel, Heine pays the bonus for
# the ten fangs; with his page still open, a lizardman's fourth roll gives a barrel alone and a third
# roll two fangs and a missed barrel; holding both items, Heine keeps the quest going; then he turns
# the barrels into bills (cond 2). Expectations replay the reference trace of this scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q351_black_swan_bonus.golden
character Swan 32
quest Q351_BlackSwan <cond>=1 <state>=STARTED
hold 4296 1
hold 4297 10
hold 4298 1
random 3 0 2 0 999999
script quest.Q351_BlackSwan
item 57 4296 4297 4298 4310
page guard/30916.htm
page default/30969.htm
page villagemaster/30897.htm
page script/quest/Q351_BlackSwan/
npc gosta 30916 Guard 10 0 0
npc iason 30969 Folk -10 0 0
npc roman 30897 VillageMasterDwarf 0 10 0
npc lizard 20784 Monster 40 0 0

# Heine: ten fangs and the bonus.
action iason
action iason
  S ActionFailed
  S NpcHtmlMessage obj=iason item=0 page=default/30969.htm
  S ActionFailed
bypass npc_{iason}_Quest
  S NpcHtmlMessage obj=iason item=0 page=script/quest/Q351_BlackSwan/30969-01.htm
  S ActionFailed
  S ActionFailed
bypass Quest Q351_BlackSwan 30969-02a.htm
  S SystemMessage id=301 3:4297 6:10
  S SystemMessage id=52 6:4080
  S NpcHtmlMessage obj=iason item=0 page=script/quest/Q351_BlackSwan/30969-02.htm
  S ActionFailed
  items 4297=0 57=4080
bypass Quest Q351_BlackSwan 30969-04.htm
  S NpcHtmlMessage obj=iason item=0 page=script/quest/Q351_BlackSwan/30969-04.htm
  S ActionFailed

# A barrel alone, then two fangs and no barrel.
kill lizard
  S SystemMessage id=95 1:0 1:0
  S SystemMessage id=54 3:4298
  S PlaySound type=0 file=ItemSound.quest_itemget bind=0 obj=0 loc=0,0,0 delay=0
  items 4297=0 4298=2
kill lizard
  S SystemMessage id=95 1:0 1:0
  S SystemMessage id=53 3:4297 6:2
  S PlaySound type=0 file=ItemSound.quest_itemget bind=0 obj=0 loc=0,0,0 delay=0
  items 4297=2 4298=2

# Heine: both items held, so the quest goes on.
bypass Quest Q351_BlackSwan 30969-05.htm
  S NpcHtmlMessage obj=iason item=0 page=script/quest/Q351_BlackSwan/30969-05.htm
  S ActionFailed
bypass Quest Q351_BlackSwan 30969-06.htm
  S NpcHtmlMessage obj=iason item=0 page=script/quest/Q351_BlackSwan/30969-06.htm
  S ActionFailed
  items 4297=2 4298=2
  rows Q351_BlackSwan <cond>=1 <state>=STARTED

# Heine: the barrels (cond 2).
bypass Quest Q351_BlackSwan 30969-04.htm
  S NpcHtmlMessage obj=iason item=0 page=script/quest/Q351_BlackSwan/30969-04.htm
  S ActionFailed
bypass Quest Q351_BlackSwan 30969-03a.htm
  S SystemMessage id=301 3:4298 6:2
  S SystemMessage id=53 3:4310 6:2
  S SystemMessage id=52 6:40
  S QuestList 351:0x80000003
  S ExShowQuestMark quest=351
  S PlaySound type=0 file=ItemSound.quest_middle bind=0 obj=0 loc=0,0,0 delay=0
  S NpcHtmlMessage obj=iason item=0 page=script/quest/Q351_BlackSwan/30969-03.htm
  S ActionFailed
  Q upsert Q351_BlackSwan | <cond> | 2
  items 4298=0 4310=2 57=4120
  rows Q351_BlackSwan <cond>=2 <state>=STARTED
