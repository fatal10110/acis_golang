# Q221_TestimonyOfProsperity, start with the diamonds already paid: the character holds the secondClassChange37 memo, so the start event gives no
# Dimensional Diamonds (no item message, no memo write) and the accept page is the plain one, not the "a" page.
# Hand-written from the quest script (no reference trace).
character Dwarf 38
class 54
memo secondClassChange37 true
script quest.Q221_TestimonyOfProsperity
item 3023 3030 3238 3239 3240 3241 3242 3243 3244 3245 3246 3247 3248 3249 3250 3251 3252 3253 3254 3255 3256 3257 3258 3259 3260 3261 3262 3263 3264 3265 3266 3267 3268 3269 3270 3271 3272 3273 3274 3275 3428 1867 57 7562
page warehouse/30104.htm
page script/quest/Q221_TestimonyOfProsperity/
npc parman 30104 WarehouseKeeper 10 0 0

action parman
action parman
  S ActionFailed
  S NpcHtmlMessage obj=parman item=0 page=warehouse/30104.htm
  S ActionFailed
bypass npc_{parman}_Quest
  S NpcHtmlMessage obj=parman item=0 page=script/quest/Q221_TestimonyOfProsperity/30104-03.htm
  S ActionFailed
  S ActionFailed
bypass Quest Q221_TestimonyOfProsperity 30104-04.htm
  S QuestList 221:0x80000001
  S ExShowQuestMark quest=221
  S PlaySound type=0 file=ItemSound.quest_accept bind=0 obj=0 loc=0,0,0 delay=0
  S SystemMessage id=54 3:3239
  S NpcHtmlMessage obj=parman item=0 page=script/quest/Q221_TestimonyOfProsperity/30104-04.htm
  S ActionFailed
  Q upsert Q221_TestimonyOfProsperity | <state> | STARTED
  Q upsert Q221_TestimonyOfProsperity | <cond> | 1
  state Q221_TestimonyOfProsperity STARTED
  rows Q221_TestimonyOfProsperity <cond>=1 <state>=STARTED
  items 3239=1
