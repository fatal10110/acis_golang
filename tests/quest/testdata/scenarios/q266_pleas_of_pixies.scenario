  Q upsert Q266_PleasOfPixies | <state> | STARTED
  Q upsert Q266_PleasOfPixies | <cond> | 1
  state Q266_PleasOfPixies STARTED
  rows Q266_PleasOfPixies <cond>=1 <state>=STARTED

# A gray wolf (two fangs), a young red keltir (one) and a red keltir (one).
kill gray
  S SystemMessage id=95 1:0 1:0
  S SystemMessage id=53 3:1334 6:2
  S PlaySound type=0 file=ItemSound.quest_itemget bind=0 obj=0 loc=0,0,0 delay=0
  items 1334=2
kill young
  S SystemMessage id=95 1:0 1:0
  S SystemMessage id=54 3:1334
  S PlaySound type=0 file=ItemSound.quest_itemget bind=0 obj=0 loc=0,0,0 delay=0
  items 1334=3
kill red
  S SystemMessage id=95 1:0 1:0
  S SystemMessage id=54 3:1334
  S PlaySound type=0 file=ItemSound.quest_itemget bind=0 obj=0 loc=0,0,0 delay=0
  items 1334=4

# Murika: too few fangs.
action murika
  S ActionFailed
  S NpcHtmlMessage obj=murika item=0 page=default/31852.htm
  S ActionFailed
bypass npc_{murika}_Quest
  S NpcHtmlMessage obj=murika item=0 page=script/quest/Q266_PleasOfPixies/31852-04.htm
  S ActionFailed
  S ActionFailed

