# Pleas of Pixies (Q266): an elven fighter of level 3 accepts at Murika; a gray wolf gives two
# predator fangs (its two-or-three roll pinned to two), a young red keltir one, a red keltir one
# (its count roll pinned to one) and elder red keltirs two each (every drop roll pinned to succeed),
# the hundredth fang moving the quest on; Murika takes them and rolls the gem, here pinned to the
# jackpot emerald, and the repeatable quest ends; then relog. Expectations replay the reference
# trace of this scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q266_pleas_of_pixies.golden
character Pixie 3
class 18
random always 0
script quest.Q266_PleasOfPixies
item 1334 1336 1337 1338 1339
page default/31852.htm
page script/quest/Q266_PleasOfPixies/
npc murika 31852 Folk 10 0 0
npc gray 20525 Monster 40 0 0
npc young 20530 Monster 0 40 0
npc red 20534 Monster -40 0 0
npc elder 20537 Monster 0 -40 0

# Murika: accept.
action murika
action murika
  S ActionFailed
  S NpcHtmlMessage obj=murika item=0 page=default/31852.htm
  S ActionFailed
bypass npc_{murika}_Quest
  S NpcHtmlMessage obj=murika item=0 page=script/quest/Q266_PleasOfPixies/31852-02.htm
  S ActionFailed
  S ActionFailed
