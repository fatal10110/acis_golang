# Illegitimate Child of a Goddess (Q358): a level 63 character accepts at Oltlin through her
# pages; she waits for scales; a Trives gives a scale (every roll pinned to succeed); then relog.
# Expectations replay the reference trace of this scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q358_illegitimate_child_of_a_goddess.golden
character Oltlin 63
random always 0
script quest.Q358_IllegitimateChildOfAGoddess
item 57 5868 6329 6331 6333 6335 6337 6339 5364 5366
page villagemaster/30862.htm
page script/quest/Q358_IllegitimateChildOfAGoddess/
npc oltlin 30862 VillageMasterDElf 10 0 0
npc trives 20672 Monster 40 0 0

# Oltlin: accept through 30862-03 and 04.
action oltlin
action oltlin
  S ActionFailed
  S NpcHtmlMessage obj=oltlin item=0 page=villagemaster/30862.htm
  S ActionFailed
bypass npc_{oltlin}_Quest
  S NpcHtmlMessage obj=oltlin item=0 page=script/quest/Q358_IllegitimateChildOfAGoddess/30862-02.htm
  S ActionFailed
  S ActionFailed
bypass Quest Q358_IllegitimateChildOfAGoddess 30862-03.htm
  S NpcHtmlMessage obj=oltlin item=0 page=script/quest/Q358_IllegitimateChildOfAGoddess/30862-03.htm
  S ActionFailed
bypass Quest Q358_IllegitimateChildOfAGoddess 30862-04.htm
  S NpcHtmlMessage obj=oltlin item=0 page=script/quest/Q358_IllegitimateChildOfAGoddess/30862-04.htm
  S ActionFailed
bypass Quest Q358_IllegitimateChildOfAGoddess 30862-05.htm
  S QuestList 358:0x80000001
  S ExShowQuestMark quest=358
  S PlaySound type=0 file=ItemSound.quest_accept bind=0 obj=0 loc=0,0,0 delay=0
  S NpcHtmlMessage obj=oltlin item=0 page=script/quest/Q358_IllegitimateChildOfAGoddess/30862-05.htm
  S ActionFailed
  Q upsert Q358_IllegitimateChildOfAGoddess | <state> | STARTED
  Q upsert Q358_IllegitimateChildOfAGoddess | <cond> | 1
  rows Q358_IllegitimateChildOfAGoddess <cond>=1 <state>=STARTED
  state Q358_IllegitimateChildOfAGoddess STARTED
action oltlin
  S ActionFailed
  S NpcHtmlMessage obj=oltlin item=0 page=villagemaster/30862.htm
  S ActionFailed
action oltlin
  S ActionFailed
  S NpcHtmlMessage obj=oltlin item=0 page=villagemaster/30862.htm
  S ActionFailed
bypass npc_{oltlin}_Quest
  S NpcHtmlMessage obj=oltlin item=0 page=script/quest/Q358_IllegitimateChildOfAGoddess/30862-06.htm
  S ActionFailed
  S ActionFailed

# A Trives: a scale.
kill trives
  S SystemMessage id=95 1:0 1:0
  S SystemMessage id=54 3:5868
  S PlaySound type=0 file=ItemSound.quest_itemget bind=0 obj=0 loc=0,0,0 delay=0
  items 5868=1
  rows Q358_IllegitimateChildOfAGoddess <cond>=1 <state>=STARTED
relog
  rows Q358_IllegitimateChildOfAGoddess <cond>=1 <state>=STARTED
  items 5868=1
