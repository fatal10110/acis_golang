# Resurrection of an Old Manager (Q114): a level 48 character who completed Pavel the Giant
# (Q121, its journal seeded) is too young for Yumi. Expectations replay the
# reference trace of this scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q114_resurrection_of_an_old_manager_low_level.golden
character Manager 48
quest Q121_PavelTheGiant <state>=COMPLETED
script quest.Q114_ResurrectionOfAnOldManager
script quest.Q121_PavelTheGiant
page default/32041.htm
page script/quest/Q114_ResurrectionOfAnOldManager/
npc yumi 32041 Folk 10 0 0

action yumi
action yumi
  S ActionFailed
  S NpcHtmlMessage obj=yumi item=0 page=default/32041.htm
  S ActionFailed
bypass npc_{yumi}_Quest
  S NpcHtmlMessage obj=yumi item=0 html="<html><body><a action=\"bypass -h npc_{yumi}_Quest Q121_PavelTheGiant\">[Pavel the Giant (Done)]</a><br><a action=\"bypass -h npc_{yumi}_Quest Q114_ResurrectionOfAnOldManager\">[Resurrection of an Old Manager]</a><br></body></html>"
  S ActionFailed
  S ActionFailed
bypass npc_{yumi}_Quest Q114_ResurrectionOfAnOldManager
  S NpcHtmlMessage obj=yumi item=0 page=script/quest/Q114_ResurrectionOfAnOldManager/32041-00.htm
  S ActionFailed
  S ActionFailed
  state Q114_ResurrectionOfAnOldManager CREATED
  rows Q114_ResurrectionOfAnOldManager -
