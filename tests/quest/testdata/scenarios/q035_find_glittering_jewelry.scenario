kill alligator
  S SystemMessage id=95 1:0 1:0
  S SystemMessage id=54 3:7162
  S PlaySound type=0 file=ItemSound.quest_middle bind=0 obj=0 loc=0,0,0 delay=0
  S QuestList 37:0x8000003f 35:0x80000007
  S ExShowQuestMark quest=35
