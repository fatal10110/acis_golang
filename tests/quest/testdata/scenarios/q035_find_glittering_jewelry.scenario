  S ActionFailed
bypass Quest Q035_FindGlitteringJewelry 30091-5.htm
  S SystemMessage id=301 3:1893 6:5
  S SystemMessage id=301 3:1873 6:500
  S SystemMessage id=301 3:4044 6:150
  S SystemMessage id=54 3:7077
  S PlaySound type=0 file=ItemSound.quest_finish bind=0 obj=0 loc=0,0,0 delay=0
  S QuestList 37:0x8000003f 35:0x00000000
  S NpcHtmlMessage obj=ellie item=0 page=script/quest/Q035_FindGlitteringJewelry/30091-5.htm
  S ActionFailed
  Q upsert Q035_FindGlitteringJewelry | <state> | COMPLETED
  Q delete-except-state Q035_FindGlitteringJewelry
  state Q035_FindGlitteringJewelry COMPLETED
  rows Q035_FindGlitteringJewelry <state>=COMPLETED
  items 1893=0 1873=0 4044=0 7077=1

# Relog: the completed quest loads from its one row, and the box stays.
relog
  state Q035_FindGlitteringJewelry COMPLETED
  rows Q035_FindGlitteringJewelry <state>=COMPLETED
  items 7077=1
action ellie
action ellie
  S ActionFailed
  S NpcHtmlMessage obj=ellie item=0 page=merchant/30091.htm
  S ActionFailed
bypass npc_{ellie}_Quest
  S NpcHtmlMessage obj=ellie item=0 html="<html><body>This quest has already been completed.</body></html>"
  S ActionFailed
  S ActionFailed
