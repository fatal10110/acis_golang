# Ellie takes the jewels.
action ellie
action ellie
  S ActionFailed
  S NpcHtmlMessage obj=ellie item=0 page=merchant/30091.htm
  S ActionFailed
bypass npc_{ellie}_Quest
  S NpcHtmlMessage obj=ellie item=0 page=script/quest/Q035_FindGlitteringJewelry/30091-2.htm
  S ActionFailed
  S ActionFailed
bypass Quest Q035_FindGlitteringJewelry 30091-3.htm
  S QuestList 37:0x8000003f 35:0x8000000f
  S ExShowQuestMark quest=35
  S PlaySound type=0 file=ItemSound.quest_middle bind=0 obj=0 loc=0,0,0 delay=0
  S SystemMessage id=301 3:7162 6:10
  S NpcHtmlMessage obj=ellie item=0 page=script/quest/Q035_FindGlitteringJewelry/30091-3.htm
  S ActionFailed
  Q upsert Q035_FindGlitteringJewelry | <cond> | 4
  items 7162=0
  rows Q035_FindGlitteringJewelry <cond>=4 <state>=STARTED

# Ellie makes the jewel box; the quest completes.
action ellie
  S ActionFailed
  S NpcHtmlMessage obj=ellie item=0 page=merchant/30091.htm
  S ActionFailed
bypass npc_{ellie}_Quest
  S NpcHtmlMessage obj=ellie item=0 page=script/quest/Q035_FindGlitteringJewelry/30091-4.htm
