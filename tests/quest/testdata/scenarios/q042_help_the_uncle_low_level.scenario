# Help the Uncle! (Q042), refused: a level 24 character, one short of the quest's level, is turned
# away by Waters and the quest is not started.
# Not traced (#4105): the starter's page lists multisell 101, the Go run's player object id, which
# the Go render names {player}. Played with its trace line, the reference trace matched every step;
# the starter's page lines below are that page with 101 written as {player}.
character Helper 24
script quest.Q042_HelpTheUncle
item 291 7548 7549 7583
page merchant/30828.htm
page script/quest/Q042_HelpTheUncle/
npc waters 30828 Merchant 10 0 0

action waters
action waters
  S ActionFailed
  S NpcHtmlMessage obj=waters item=0 html="<html><body>Pet Manager Waters:<br>\nWe've got a special food that wolves absolutely love. If you feed this to your wolf, it will tear even a turek war hound to shreds! We also have Steel teeth made by Dwarven hooligans! And hatchling products! Feel free to look around! Good owners always come to this Pet Kennel of Dion Castle Town.<br>\n<a action=\"bypass -h npc_{waters}_Buy 91\">Buy a pet product</a><br>\n<a action=\"bypass -h npc_{waters}_exc_multisell 1000\">Upgrade Pet Equipment</a><br>\n<a action=\"bypass -h npc_{waters}_multisell 999\">Exchange the hatchling equipment with the strider equipment</a><br>\n<a action=\"bypass -h npc_{waters}_multisell {player}\">Exchange the pet trade ticket with a pet</a><br>\n<a action=\"bypass -h npc_{waters}_Sell\">Sell your item</a><br>\n<a action=\"bypass -h npc_{waters}_TerritoryStatus\">See the lord and get the tax rate information</a><br>\n<a action=\"bypass -h npc_{waters}_Quest\">Quest</a>\n</body></html>\n"
  S ActionFailed
bypass npc_{waters}_Quest
  S NpcHtmlMessage obj=waters item=0 page=script/quest/Q042_HelpTheUncle/30828-00a.htm
  S ActionFailed
  S ActionFailed
  state Q042_HelpTheUncle CREATED
  rows Q042_HelpTheUncle -
