# In Search of the Nest (Q109), the scout's memo: a level 66 character holding a Golden Ram recruit
# badge, on cond 1, finds Pierce's chat window without a Quest link (the shipped page offers none, so
# the Quest bypass is refused and Pierce's branches cannot be reached), then takes the memo from the
# scout's corpse; then relog. Expectations replay the reference trace of this scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q109_in_search_of_the_nest.golden
character Mercenary 66
quest Q109_InSearchOfTheNest <cond>=1 <state>=STARTED
hold 7246 1
script quest.Q109_InSearchOfTheNest
item 8083 7246 7247 57
page default/31553.htm
page default/32015.htm
page script/quest/Q109_InSearchOfTheNest/
npc pierce 31553 Folk 10 0 0
npc corpse 32015 Folk 20 0 0

# Pierce: no Quest link, nothing happens.
action pierce
action pierce
  S ActionFailed
  S NpcHtmlMessage obj=pierce item=0 page=default/31553.htm
  S ActionFailed
bypass npc_{pierce}_Quest
  state Q109_InSearchOfTheNest STARTED
  rows Q109_InSearchOfTheNest <cond>=1 <state>=STARTED

# The scout's corpse: the memo.
action corpse
action corpse
  S ActionFailed
  S NpcHtmlMessage obj=corpse item=0 page=default/32015.htm
  S ActionFailed
bypass npc_{corpse}_Quest
  S NpcHtmlMessage obj=corpse item=0 page=script/quest/Q109_InSearchOfTheNest/32015-01.htm
  S ActionFailed
  S ActionFailed
bypass Quest Q109_InSearchOfTheNest 32015-02.htm
  S QuestList 109:0x80000003
  S ExShowQuestMark quest=109
  S PlaySound type=0 file=ItemSound.quest_middle bind=0 obj=0 loc=0,0,0 delay=0
  S SystemMessage id=54 3:8083
  S NpcHtmlMessage obj=corpse item=0 page=script/quest/Q109_InSearchOfTheNest/32015-02.htm
  S ActionFailed
  Q upsert Q109_InSearchOfTheNest | <cond> | 2
  rows Q109_InSearchOfTheNest <cond>=2 <state>=STARTED
  items 8083=1
action corpse
  S ActionFailed
  S NpcHtmlMessage obj=corpse item=0 page=default/32015.htm
  S ActionFailed
bypass npc_{corpse}_Quest
  S NpcHtmlMessage obj=corpse item=0 page=script/quest/Q109_InSearchOfTheNest/32015-02.htm
  S ActionFailed
  S ActionFailed

relog
  items 8083=1 7246=1
  state Q109_InSearchOfTheNest STARTED
  rows Q109_InSearchOfTheNest <cond>=2 <state>=STARTED
