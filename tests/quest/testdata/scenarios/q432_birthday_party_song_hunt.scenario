# Birthday Party Song (Q432): with 49 red crystals, a Roughly Hewn Rock Golem kill gives the 50th
# (every roll pinned to succeed) and moves the quest to the second stage. Expectations replay the
# reference trace of this scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q432_birthday_party_song_hunt.golden
character Hero 35
quest Q432_BirthdayPartySong <cond>=1 <state>=STARTED
hold 7541 49
random always 0
script quest.Q432_BirthdayPartySong
item 7541 7061
page default/31043.htm
page script/quest/Q432_BirthdayPartySong/
npc octavia 31043 Folk 10 0 0
npc golem 21103 Monster 40 0 0

action octavia
action octavia
  S ActionFailed
  S NpcHtmlMessage obj=octavia item=0 page=default/31043.htm
  S ActionFailed
bypass npc_{octavia}_Quest
  S NpcHtmlMessage obj=octavia item=0 page=script/quest/Q432_BirthdayPartySong/31043-03.htm
  S ActionFailed
  S ActionFailed
kill golem
  S SystemMessage id=95 1:0 1:0
  S SystemMessage id=54 3:7541
  S PlaySound type=0 file=ItemSound.quest_middle bind=0 obj=0 loc=0,0,0 delay=0
  S QuestList 432:0x80000003
  S ExShowQuestMark quest=432
  Q upsert Q432_BirthdayPartySong | <cond> | 2
  items 7541=50
  rows Q432_BirthdayPartySong <cond>=2 <state>=STARTED
  state Q432_BirthdayPartySong STARTED
action octavia
  S ActionFailed
  S NpcHtmlMessage obj=octavia item=0 page=default/31043.htm
  S ActionFailed
action octavia
  S ActionFailed
  S NpcHtmlMessage obj=octavia item=0 page=default/31043.htm
  S ActionFailed
bypass npc_{octavia}_Quest
