# Forgotten Truth (Q106): a dark elven mystic of level 10 accepts at Thifiell and takes her onyx
# talisman to Kartia, kills two Tumran orc brigands for the ancient scroll and clay tablet (every
# roll pinned to succeed) and brings Kartia's translation back to Thifiell, who gives the Eldritch
# Dagger, a mystic's spiritshots, the newbie spiritshots and the echo crystals; then relog.
# Expectations replay the reference trace of this scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q106_forgotten_truth.golden
character Seeker 10
class 38
random always 0
script quest.Q106_ForgottenTruth
item 984 985 986 987 988 989 1060 1835 2509 4412 4413 4414 4415 4416 5790
page villagemaster/30358.htm
page default/30133.htm
page script/quest/Q106_ForgottenTruth/
npc thifiell 30358 VillageMasterDElf 10 0 0
npc kartia 30133 Folk 20 0 0
npc brigand 27070 Monster 40 0 0

# Thifiell: two pages, then accept.
action thifiell
action thifiell
  S ActionFailed
  S NpcHtmlMessage obj=thifiell item=0 page=villagemaster/30358.htm
  S ActionFailed
bypass npc_{thifiell}_Quest
  S NpcHtmlMessage obj=thifiell item=0 page=script/quest/Q106_ForgottenTruth/30358-03.htm
  S ActionFailed
  S ActionFailed
  state Q106_ForgottenTruth CREATED
bypass Quest Q106_ForgottenTruth 30358-04.htm
  S NpcHtmlMessage obj=thifiell item=0 page=script/quest/Q106_ForgottenTruth/30358-04.htm
  S ActionFailed
bypass Quest Q106_ForgottenTruth 30358-05.htm
  S QuestList 106:0x80000001
  S ExShowQuestMark quest=106
  S PlaySound type=0 file=ItemSound.quest_accept bind=0 obj=0 loc=0,0,0 delay=0
  S SystemMessage id=54 3:984
  S NpcHtmlMessage obj=thifiell item=0 page=script/quest/Q106_ForgottenTruth/30358-05.htm
  S ActionFailed
  Q upsert Q106_ForgottenTruth | <state> | STARTED
  Q upsert Q106_ForgottenTruth | <cond> | 1
  state Q106_ForgottenTruth STARTED
  rows Q106_ForgottenTruth <cond>=1 <state>=STARTED
  items 984=1
action thifiell
  S ActionFailed
  S NpcHtmlMessage obj=thifiell item=0 page=villagemaster/30358.htm
  S ActionFailed
bypass npc_{thifiell}_Quest
  S NpcHtmlMessage obj=thifiell item=0 page=script/quest/Q106_ForgottenTruth/30358-06.htm
  S ActionFailed
  S ActionFailed

