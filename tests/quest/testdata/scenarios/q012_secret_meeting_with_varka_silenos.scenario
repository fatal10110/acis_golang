# Secret Meeting With Varka Silenos (Q012): a level 74 character accepts at Cadmon, gets the box
# of munitions from Helmut and hands it to Naran Ashanuk for experience; then relog. Naran
# Ashanuk's first-talk script (VarkaSilenosSupport) is not listed, so his chat window is the
# default page, as the reference serves it for an NPC with no page of its own. Expectations
# replay the reference trace of this scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q012_secret_meeting_with_varka_silenos.golden
character Envoy 74
script quest.Q012_SecretMeetingWithVarkaSilenos
item 7232
page guard/31296.htm
page merchant/31258.htm
page npcdefault.htm
page script/quest/Q012_SecretMeetingWithVarkaSilenos/
npc cadmon 31296 Guard 10 0 0
npc helmut 31258 Merchant 20 0 0
npc naran 31378 Folk 30 0 0

# Cadmon: accept.
action cadmon
action cadmon
  S ActionFailed
  S NpcHtmlMessage obj=cadmon item=0 page=guard/31296.htm
  S ActionFailed
bypass npc_{cadmon}_Quest
  S NpcHtmlMessage obj=cadmon item=0 page=script/quest/Q012_SecretMeetingWithVarkaSilenos/31296-01.htm
  S ActionFailed
  S ActionFailed
  state Q012_SecretMeetingWithVarkaSilenos CREATED
bypass Quest Q012_SecretMeetingWithVarkaSilenos 31296-03.htm
  S QuestList 12:0x80000001
  S ExShowQuestMark quest=12
  S PlaySound type=0 file=ItemSound.quest_accept bind=0 obj=0 loc=0,0,0 delay=0
  S NpcHtmlMessage obj=cadmon item=0 page=script/quest/Q012_SecretMeetingWithVarkaSilenos/31296-03.htm
  S ActionFailed
  Q upsert Q012_SecretMeetingWithVarkaSilenos | <state> | STARTED
  Q upsert Q012_SecretMeetingWithVarkaSilenos | <cond> | 1
  state Q012_SecretMeetingWithVarkaSilenos STARTED
  rows Q012_SecretMeetingWithVarkaSilenos <cond>=1 <state>=STARTED
action cadmon
  S ActionFailed
  S NpcHtmlMessage obj=cadmon item=0 page=guard/31296.htm
  S ActionFailed
bypass npc_{cadmon}_Quest
  S NpcHtmlMessage obj=cadmon item=0 page=script/quest/Q012_SecretMeetingWithVarkaSilenos/31296-04.htm
  S ActionFailed
  S ActionFailed

# Naran Ashanuk has nothing to say before the box.
action naran
action naran
  S ActionFailed
  S NpcHtmlMessage obj=naran item=0 page=npcdefault.htm
  S ActionFailed
bypass npc_{naran}_Quest
  S NpcHtmlMessage obj=naran item=0 html="<html><body>You are either not on a quest that involves this NPC, or you don't meet this NPC's minimum quest requirements.</body></html>"
  S ActionFailed
  S ActionFailed

# Helmut gives the box of munitions.
action helmut
action helmut
  S ActionFailed
  S NpcHtmlMessage obj=helmut item=0 page=merchant/31258.htm
  S ActionFailed
bypass npc_{helmut}_Quest
  S NpcHtmlMessage obj=helmut item=0 page=script/quest/Q012_SecretMeetingWithVarkaSilenos/31258-01.htm
  S ActionFailed
  S ActionFailed
bypass Quest Q012_SecretMeetingWithVarkaSilenos 31258-02.htm
  S SystemMessage id=54 3:7232
  S QuestList 12:0x80000003
  S ExShowQuestMark quest=12
  S PlaySound type=0 file=ItemSound.quest_middle bind=0 obj=0 loc=0,0,0 delay=0
  S NpcHtmlMessage obj=helmut item=0 page=script/quest/Q012_SecretMeetingWithVarkaSilenos/31258-02.htm
  S ActionFailed
  Q upsert Q012_SecretMeetingWithVarkaSilenos | <cond> | 2
  rows Q012_SecretMeetingWithVarkaSilenos <cond>=2 <state>=STARTED
  items 7232=1
action helmut
  S ActionFailed
  S NpcHtmlMessage obj=helmut item=0 page=merchant/31258.htm
  S ActionFailed
bypass npc_{helmut}_Quest
  S NpcHtmlMessage obj=helmut item=0 page=script/quest/Q012_SecretMeetingWithVarkaSilenos/31258-03.htm
  S ActionFailed
  S ActionFailed

# Naran Ashanuk takes the box: experience; the quest completes.
action naran
action naran
  S ActionFailed
  S NpcHtmlMessage obj=naran item=0 page=npcdefault.htm
  S ActionFailed
bypass npc_{naran}_Quest
  S NpcHtmlMessage obj=naran item=0 page=script/quest/Q012_SecretMeetingWithVarkaSilenos/31378-01.htm
  S ActionFailed
  S ActionFailed
bypass Quest Q012_SecretMeetingWithVarkaSilenos 31378-02.htm
  S SystemMessage id=302 3:7232
  S SystemMessage id=45 1:79761
  S PlaySound type=0 file=ItemSound.quest_finish bind=0 obj=0 loc=0,0,0 delay=0
  S QuestList 12:0x00000000
  S NpcHtmlMessage obj=naran item=0 page=script/quest/Q012_SecretMeetingWithVarkaSilenos/31378-02.htm
  S ActionFailed
  Q upsert Q012_SecretMeetingWithVarkaSilenos | <state> | COMPLETED
  Q delete-except-state Q012_SecretMeetingWithVarkaSilenos
  state Q012_SecretMeetingWithVarkaSilenos COMPLETED
  rows Q012_SecretMeetingWithVarkaSilenos <state>=COMPLETED
  items 7232=0

# Relog: the completed quest loads from its one row.
relog
  state Q012_SecretMeetingWithVarkaSilenos COMPLETED
  rows Q012_SecretMeetingWithVarkaSilenos <state>=COMPLETED
action cadmon
action cadmon
  S ActionFailed
  S NpcHtmlMessage obj=cadmon item=0 page=guard/31296.htm
  S ActionFailed
bypass npc_{cadmon}_Quest
  S NpcHtmlMessage obj=cadmon item=0 html="<html><body>This quest has already been completed.</body></html>"
  S ActionFailed
  S ActionFailed
