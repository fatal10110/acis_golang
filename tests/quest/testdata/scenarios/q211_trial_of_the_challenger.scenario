# Trial of the Challenger (Q211), a second class-change trial, played by a level 36
# Warrior: Kash starts it and pays the level 35 set's Dimensional Diamonds (61 for a
# Warrior, once per character); Shyslassys' death gives the broken key and the scroll and
# leaves his chest, which pays the jackpot (draws 0 then 95: the five patterns); Kash
# trades the scroll for his letter; Martien takes the letter, then Gorr's eye; Raldo takes
# Baraham's eye; Filaur sends the player to the Succubus Queen; Raldo hands over the Mark
# of Challenger and completes the quest. Expectations are derived from the reference
# source (Q211_TrialOfTheChallenger.java, SecondClassQuest.java, Quest.dropItemsAlways).
trace internal/gameserver/script/testdata/oracle/scenarios/q211_trial_of_the_challenger.golden
character Challenger 36
class 1
random 0 95 0 0
script quest.Q211_TrialOfTheChallenger
item 2627 2628 2629 2630 2631 2632 7562 1940 1943 1946 2918 2927
page default/30644.htm
page default/30645.htm
page default/30646.htm
page default/30647.htm
page default/30535.htm
page script/quest/Q211_TrialOfTheChallenger/
npc kash 30644 Folk 10 0 0
npc martien 30645 Folk -10 0 0
npc raldo 30646 Folk 0 10 0
npc chest 30647 Folk 0 -10 0
npc filaur 30535 Folk 20 20 0
npc shyslassys 27110 Monster 40 0 0
npc gorr 27112 Monster -40 0 0
npc baraham 27113 Monster 0 40 0
npc succubus 27114 Monster 0 -40 0

# Kash: a Warrior of level 36 may start; the first trial of the set pays the diamonds,
# which turns the accept page into 30644-05a.htm.
action kash
action kash
  S ActionFailed
  S NpcHtmlMessage obj=kash item=0 page=default/30644.htm
  S ActionFailed
bypass npc_{kash}_Quest
  S NpcHtmlMessage obj=kash item=0 page=script/quest/Q211_TrialOfTheChallenger/30644-03.htm
  S ActionFailed
  S ActionFailed
  state Q211_TrialOfTheChallenger CREATED
bypass Quest Q211_TrialOfTheChallenger 30644-04.htm
  S NpcHtmlMessage obj=kash item=0 page=script/quest/Q211_TrialOfTheChallenger/30644-04.htm
  S ActionFailed
bypass Quest Q211_TrialOfTheChallenger 30644-05.htm
  S QuestList 211:0x80000001
  S ExShowQuestMark quest=211
  S PlaySound type=0 file=ItemSound.quest_accept bind=0 obj=0 loc=0,0,0 delay=0
  S SystemMessage id=53 3:7562 6:61
  S NpcHtmlMessage obj=kash item=0 page=script/quest/Q211_TrialOfTheChallenger/30644-05a.htm
  S ActionFailed
  Q upsert Q211_TrialOfTheChallenger | <state> | STARTED
  Q upsert Q211_TrialOfTheChallenger | <cond> | 1
  items 7562=61

# Shyslassys: the key and the scroll; his chest appears where he fell.
kill shyslassys
  S SystemMessage id=95 1:0 1:0
  S QuestList 211:0x80000003
  S ExShowQuestMark quest=211
  S PlaySound type=0 file=ItemSound.quest_middle bind=0 obj=0 loc=0,0,0 delay=0
  S SystemMessage id=54 3:2632
  S SystemMessage id=54 3:2631
  Q upsert Q211_TrialOfTheChallenger | <cond> | 2
  items 2631=1 2632=1

