# Secret Meeting With Ketra Orcs (Q011): a level 74 character accepts at Cadmon, gets the box of
# munitions from Leon and hands it to Wahkan for experience; then relog. Wahkan's first-talk script
# (KetraOrcSupport) is not listed, so his chat window is the default page, as the reference serves
# it for an NPC with no page of its own. Expectations replay the reference trace of this scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q011_secret_meeting_with_ketra_orcs.golden
character Envoy 74
script quest.Q011_SecretMeetingWithKetraOrcs
item 7231
page guard/31296.htm
page merchant/31256.htm
page npcdefault.htm
page script/quest/Q011_SecretMeetingWithKetraOrcs/
npc cadmon 31296 Guard 10 0 0
npc leon 31256 Merchant 20 0 0
npc wahkan 31371 Folk 30 0 0

# Cadmon: accept.
action cadmon
action cadmon
  S ActionFailed
  S NpcHtmlMessage obj=cadmon item=0 page=guard/31296.htm
  S ActionFailed
bypass npc_{cadmon}_Quest
  S NpcHtmlMessage obj=cadmon item=0 page=script/quest/Q011_SecretMeetingWithKetraOrcs/31296-01.htm
  S ActionFailed
  S ActionFailed
  state Q011_SecretMeetingWithKetraOrcs CREATED
bypass Quest Q011_SecretMeetingWithKetraOrcs 31296-03.htm
  S QuestList 11:0x80000001
  S ExShowQuestMark quest=11
  S PlaySound type=0 file=ItemSound.quest_accept bind=0 obj=0 loc=0,0,0 delay=0
  S NpcHtmlMessage obj=cadmon item=0 page=script/quest/Q011_SecretMeetingWithKetraOrcs/31296-03.htm
  S ActionFailed
  Q upsert Q011_SecretMeetingWithKetraOrcs | <state> | STARTED
  Q upsert Q011_SecretMeetingWithKetraOrcs | <cond> | 1
  state Q011_SecretMeetingWithKetraOrcs STARTED
  rows Q011_SecretMeetingWithKetraOrcs <cond>=1 <state>=STARTED
action cadmon
  S ActionFailed
  S NpcHtmlMessage obj=cadmon item=0 page=guard/31296.htm
  S ActionFailed
bypass npc_{cadmon}_Quest
  S NpcHtmlMessage obj=cadmon item=0 page=script/quest/Q011_SecretMeetingWithKetraOrcs/31296-04.htm
  S ActionFailed
  S ActionFailed

# Wahkan has nothing to say before the box.
action wahkan
action wahkan
  S ActionFailed
  S NpcHtmlMessage obj=wahkan item=0 page=npcdefault.htm
  S ActionFailed
bypass npc_{wahkan}_Quest
  S NpcHtmlMessage obj=wahkan item=0 html="<html><body>You are either not on a quest that involves this NPC, or you don't meet this NPC's minimum quest requirements.</body></html>"
  S ActionFailed
  S ActionFailed

# Leon gives the box of munitions.
action leon
action leon
  S ActionFailed
  S NpcHtmlMessage obj=leon item=0 page=merchant/31256.htm
  S ActionFailed
bypass npc_{leon}_Quest
  S NpcHtmlMessage obj=leon item=0 page=script/quest/Q011_SecretMeetingWithKetraOrcs/31256-01.htm
  S ActionFailed
  S ActionFailed
bypass Quest Q011_SecretMeetingWithKetraOrcs 31256-02.htm
  S SystemMessage id=54 3:7231
  S QuestList 11:0x80000003
  S ExShowQuestMark quest=11
  S PlaySound type=0 file=ItemSound.quest_middle bind=0 obj=0 loc=0,0,0 delay=0
  S NpcHtmlMessage obj=leon item=0 page=script/quest/Q011_SecretMeetingWithKetraOrcs/31256-02.htm
  S ActionFailed
  Q upsert Q011_SecretMeetingWithKetraOrcs | <cond> | 2
  rows Q011_SecretMeetingWithKetraOrcs <cond>=2 <state>=STARTED
  items 7231=1
action leon
  S ActionFailed
  S NpcHtmlMessage obj=leon item=0 page=merchant/31256.htm
  S ActionFailed
bypass npc_{leon}_Quest
  S NpcHtmlMessage obj=leon item=0 page=script/quest/Q011_SecretMeetingWithKetraOrcs/31256-03.htm
  S ActionFailed
  S ActionFailed

# Wahkan takes the box: experience; the quest completes.
action wahkan
action wahkan
  S ActionFailed
  S NpcHtmlMessage obj=wahkan item=0 page=npcdefault.htm
  S ActionFailed
bypass npc_{wahkan}_Quest
  S NpcHtmlMessage obj=wahkan item=0 page=script/quest/Q011_SecretMeetingWithKetraOrcs/31371-01.htm
  S ActionFailed
  S ActionFailed
bypass Quest Q011_SecretMeetingWithKetraOrcs 31371-02.htm
  S SystemMessage id=302 3:7231
  S SystemMessage id=45 1:79787
  S PlaySound type=0 file=ItemSound.quest_finish bind=0 obj=0 loc=0,0,0 delay=0
  S QuestList 11:0x00000000
  S NpcHtmlMessage obj=wahkan item=0 page=script/quest/Q011_SecretMeetingWithKetraOrcs/31371-02.htm
  S ActionFailed
  Q upsert Q011_SecretMeetingWithKetraOrcs | <state> | COMPLETED
  Q delete-except-state Q011_SecretMeetingWithKetraOrcs
  state Q011_SecretMeetingWithKetraOrcs COMPLETED
  rows Q011_SecretMeetingWithKetraOrcs <state>=COMPLETED
  items 7231=0

# Relog: the completed quest loads from its one row.
relog
  state Q011_SecretMeetingWithKetraOrcs COMPLETED
  rows Q011_SecretMeetingWithKetraOrcs <state>=COMPLETED
action cadmon
action cadmon
  S ActionFailed
  S NpcHtmlMessage obj=cadmon item=0 page=guard/31296.htm
  S ActionFailed
bypass npc_{cadmon}_Quest
  S NpcHtmlMessage obj=cadmon item=0 html="<html><body>This quest has already been completed.</body></html>"
  S ActionFailed
  S ActionFailed
