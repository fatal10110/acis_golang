script quest.Q022_TragedyInVonHellmannForest
page villagemaster/31328.htm
page script/quest/Q022_TragedyInVonHellmannForest/
npc innocentin 31328 VillageMasterPriest -10 0 0

action innocentin
action innocentin
  S ActionFailed
  S NpcHtmlMessage obj=innocentin item=0 page=villagemaster/31328.htm
  S ActionFailed
bypass npc_{innocentin}_Quest
  S NpcHtmlMessage obj=innocentin item=0 html="<html><body><a action=\"bypass -h npc_{innocentin}_Quest Q021_HiddenTruth\">[Hidden Truth (Done)]</a><br><a action=\"bypass -h npc_{innocentin}_Quest Q022_TragedyInVonHellmannForest\">[Tragedy in von Hellmann Forest (In Progress)]</a><br></body></html>"
