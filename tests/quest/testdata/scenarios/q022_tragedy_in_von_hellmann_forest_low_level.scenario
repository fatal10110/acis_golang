  S PlaySound type=0 file=ItemSound.quest_finish bind=0 obj=0 loc=0,0,0 delay=0
  S NpcHtmlMessage obj=innocentin item=0 page=script/quest/Q022_TragedyInVonHellmannForest/31328-23.htm
