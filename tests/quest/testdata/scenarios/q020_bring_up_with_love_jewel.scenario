# Bring Up With Love (Q020), finished: a level 65 character on cond 2 holding the jewel of
# innocence (the tamed beast's step, which another script owns) gives it to Tunatun for adena and
# the quest completes; then relog. Expectations replay the reference trace of this scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q020_bring_up_with_love_jewel.golden
character Tamer 65
quest Q020_BringUpWithLove <cond>=2 <state>=STARTED
hold 7185 1
script quest.Q020_BringUpWithLove
item 7185 57
page default/31537.htm
page script/quest/Q020_BringUpWithLove/
npc tunatun 31537 Folk 10 0 0

action tunatun
action tunatun
  S ActionFailed
  S NpcHtmlMessage obj=tunatun item=0 page=default/31537.htm
  S ActionFailed
bypass npc_{tunatun}_Quest
  S NpcHtmlMessage obj=tunatun item=0 page=script/quest/Q020_BringUpWithLove/31537-11.htm
  S ActionFailed
  S ActionFailed
  state Q020_BringUpWithLove STARTED
bypass Quest Q020_BringUpWithLove 31537-12.htm
  S SystemMessage id=302 3:7185
  S SystemMessage id=52 6:68500
  S PlaySound type=0 file=ItemSound.quest_finish bind=0 obj=0 loc=0,0,0 delay=0
  S QuestList 20:0x00000000
  S NpcHtmlMessage obj=tunatun item=0 page=script/quest/Q020_BringUpWithLove/31537-12.htm
  S ActionFailed
  Q upsert Q020_BringUpWithLove | <state> | COMPLETED
  Q delete-except-state Q020_BringUpWithLove
  state Q020_BringUpWithLove COMPLETED
  rows Q020_BringUpWithLove <state>=COMPLETED
  items 7185=0 57=68500

# Relog: the completed quest loads from its one row.
relog
  state Q020_BringUpWithLove COMPLETED
  rows Q020_BringUpWithLove <state>=COMPLETED
  items 57=68500
action tunatun
action tunatun
  S ActionFailed
  S NpcHtmlMessage obj=tunatun item=0 page=default/31537.htm
  S ActionFailed
bypass npc_{tunatun}_Quest
  S NpcHtmlMessage obj=tunatun item=0 html="<html><body>This quest has already been completed.</body></html>"
  S ActionFailed
  S ActionFailed
