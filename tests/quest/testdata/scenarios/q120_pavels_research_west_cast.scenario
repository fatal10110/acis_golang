# Pavel's Research (Q120), the west weather master's cast: the character plays cond 19 to 22 as in
# q120_pavels_research_finish, and the riddles' last bypass asks the west weather master to cast
# Quest Trap - Power Shot (5073, level 5) at it (onAdvEvent, 32044-17.htm); it casts within the next
# three AI ticks. Expectations before the ticks replay the reference trace of
# q120_pavels_research_finish. The ticks are derived from the reference source and from a probe run
# with them, where the reference casts on the second tick (#4074). This scenario has no trace: the
# probe cannot play the ticks without changing the traces of later scenarios, and its NPC casts with
# the shipped template's casting stats (hit 1796 ms) where the Go runner's fixture NPC gives hit
# 2356 (#4074).
character Researcher 50
quest Q114_ResurrectionOfAnOldManager <state>=COMPLETED
quest Q120_PavelsResearch <cond>=19 <state>=STARTED talk=0 talk1=0
stub quest.Q114_ResurrectionOfAnOldManager
script quest.Q120_PavelsResearch
item 8058 8059 8060 8290 8291 8292 854
page default/32046.htm
page default/32047.htm
page default/32041.htm
page default/32042.htm
page default/32043.htm
page default/32044.htm
page default/32045.htm
page script/quest/Q120_PavelsResearch/
npc stones 32046 Folk 10 0 0
npc wendy 32047 Folk 20 0 0
npc yumi 32041 Folk 30 0 0
npc north 32042 Folk 0 10 0
npc east 32043 Folk 0 20 0
npc west 32044 Folk 0 30 0
npc shelf 32045 Folk -10 0 0

action stones
action stones
  S ActionFailed
  S NpcHtmlMessage obj=stones item=0 page=default/32046.htm
  S ActionFailed
bypass npc_{stones}_Quest
  S NpcHtmlMessage obj=stones item=0 html="<html><body><a action=\"bypass -h npc_{stones}_Quest Q114_ResurrectionOfAnOldManager\">[Resurrection of an Old Manager (Done)]</a><br><a action=\"bypass -h npc_{stones}_Quest Q120_PavelsResearch\">[Pavel's Research (In Progress)]</a><br></body></html>"
  S ActionFailed
  S ActionFailed
bypass npc_{stones}_Quest Q120_PavelsResearch
