# The Elmoreden cemetery teleporters (ElmoredenCemeteryTeleporter): with no antique brooch, the
# Imperial Tomb link takes one of the character's two used grave passes and sends it there,
# answering no page (onAdvEvent). The landing is in tests/npcs/teleporters_210_test.go (#3946).
trace internal/gameserver/script/testdata/oracle/scenarios/elmoreden_cemetery_teleporter_grave_pass.golden
character Mourner 20
hold 7261 2
item 7261 7262
script script.teleport.ElmoredenCemeteryTeleporter
page default/31919.htm
page script/teleport/ElmoredenCemeteryTeleporter/
npc chamberlain 31919 Folk 10 0 0

action chamberlain
action chamberlain
  S ActionFailed
  S NpcHtmlMessage obj=chamberlain item=0 page=default/31919.htm
  S ActionFailed
bypass Quest ElmoredenCemeteryTeleporter IT
  S SystemMessage id=302 3:7261
  S ActionFailed
  S ActionFailed
  S ActionFailed
  S ActionFailed
  S ActionFailed
  items 7261=1
