# Wedding March (Q431): with 48 silver crystals, two Lienrik kills give the 49th and the 50th (every
# roll pinned to succeed); the 50th moves the quest to the second stage. Expectations replay the
# reference trace of this scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q431_wedding_march_hunt.golden
character Hero 40
quest Q431_WeddingMarch <cond>=1 <state>=STARTED
hold 7540 48
random always 0
script quest.Q431_WeddingMarch
item 7540 7062
page default/31042.htm
page script/quest/Q431_WeddingMarch/
npc kanta 31042 Folk 10 0 0
npc lien 20786 Monster 40 0 0

# Still at the first stage: Kantabilon asks for the crystals.
action kanta
action kanta
  S ActionFailed
  S NpcHtmlMessage obj=kanta item=0 page=default/31042.htm
  S ActionFailed
bypass npc_{kanta}_Quest
  S NpcHtmlMessage obj=kanta item=0 page=script/quest/Q431_WeddingMarch/31042-02.htm
  S ActionFailed
  S ActionFailed
kill lien
  S SystemMessage id=95 1:0 1:0
  S SystemMessage id=54 3:7540
  S PlaySound type=0 file=ItemSound.quest_itemget bind=0 obj=0 loc=0,0,0 delay=0
  items 7540=49
  rows Q431_WeddingMarch <cond>=1 <state>=STARTED
  state Q431_WeddingMarch STARTED
kill lien
  S SystemMessage id=95 1:0 1:0
  S SystemMessage id=54 3:7540
  S PlaySound type=0 file=ItemSound.quest_middle bind=0 obj=0 loc=0,0,0 delay=0
  S QuestList 431:0x80000003
  S ExShowQuestMark quest=431
  Q upsert Q431_WeddingMarch | <cond> | 2
  items 7540=50
  rows Q431_WeddingMarch <cond>=2 <state>=STARTED
  state Q431_WeddingMarch STARTED
# Fifty crystals: Kantabilon takes them.
action kanta
  S ActionFailed
  S NpcHtmlMessage obj=kanta item=0 page=default/31042.htm
  S ActionFailed
action kanta
  S ActionFailed
  S NpcHtmlMessage obj=kanta item=0 page=default/31042.htm
  S ActionFailed
bypass npc_{kanta}_Quest
  S NpcHtmlMessage obj=kanta item=0 page=script/quest/Q431_WeddingMarch/31042-04.htm
  S ActionFailed
  S ActionFailed
