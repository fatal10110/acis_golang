# Chest caught with a bait of wind (Q027): a level 27 character who completed Lanosco's Special
# Bait (Q050) and holds a large blue treasure chest accepts at the fisherman, who opens the chest
# and finds a strange blueprint; Shaling trades it for a black pearl ring and the quest completes;
# then relog. The fisherman's quest link lists both his quests. Expectations replay the reference
# trace of this scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q027_chest_caught_with_a_bait_of_wind.golden
character Angler 27
quest Q050_LanoscosSpecialBait <state>=COMPLETED
hold 6500 1
script quest.Q027_ChestCaughtWithABaitOfWind
script quest.Q050_LanoscosSpecialBait
item 6500 7625 880
page fisherman/31570.htm
page merchant/31434.htm
page script/quest/Q027_ChestCaughtWithABaitOfWind/
npc lanosco 31570 Fisherman 10 0 0
npc shaling 31434 Merchant 20 0 0

# The fisherman: accept.
action lanosco
action lanosco
  S ActionFailed
  S NpcHtmlMessage obj=lanosco item=0 page=fisherman/31570.htm
  S ActionFailed
bypass npc_{lanosco}_Quest
  S NpcHtmlMessage obj=lanosco item=0 html="<html><body><a action=\"bypass -h npc_{lanosco}_Quest Q050_LanoscosSpecialBait\">[Lanosco's Special Bait (Done)]</a><br><a action=\"bypass -h npc_{lanosco}_Quest Q027_ChestCaughtWithABaitOfWind\">[Chest caught with a bait of wind]</a><br></body></html>"
  S ActionFailed
  S ActionFailed
bypass npc_{lanosco}_Quest Q027_ChestCaughtWithABaitOfWind
  S NpcHtmlMessage obj=lanosco item=0 page=script/quest/Q027_ChestCaughtWithABaitOfWind/31570-01.htm
  S ActionFailed
  S ActionFailed
  state Q027_ChestCaughtWithABaitOfWind CREATED
bypass Quest Q027_ChestCaughtWithABaitOfWind 31570-04.htm
  S QuestList 50:0x00000000 27:0x80000001
  S ExShowQuestMark quest=27
  S PlaySound type=0 file=ItemSound.quest_accept bind=0 obj=0 loc=0,0,0 delay=0
  S NpcHtmlMessage obj=lanosco item=0 page=script/quest/Q027_ChestCaughtWithABaitOfWind/31570-04.htm
  S ActionFailed
  Q upsert Q027_ChestCaughtWithABaitOfWind | <state> | STARTED
  Q upsert Q027_ChestCaughtWithABaitOfWind | <cond> | 1
  state Q027_ChestCaughtWithABaitOfWind STARTED
  rows Q027_ChestCaughtWithABaitOfWind <cond>=1 <state>=STARTED

# Shaling has nothing for the quest before the strange blueprint.
action shaling
action shaling
  S ActionFailed
  S NpcHtmlMessage obj=shaling item=0 page=merchant/31434.htm
  S ActionFailed
bypass npc_{shaling}_Quest
  S NpcHtmlMessage obj=shaling item=0 html="<html><body>You are either not on a quest that involves this NPC, or you don't meet this NPC's minimum quest requirements.</body></html>"
  S ActionFailed
  S ActionFailed

# The fisherman opens the chest.
action lanosco
action lanosco
  S ActionFailed
  S NpcHtmlMessage obj=lanosco item=0 page=fisherman/31570.htm
  S ActionFailed
bypass npc_{lanosco}_Quest
  S NpcHtmlMessage obj=lanosco item=0 html="<html><body><a action=\"bypass -h npc_{lanosco}_Quest Q027_ChestCaughtWithABaitOfWind\">[Chest caught with a bait of wind (In Progress)]</a><br><a action=\"bypass -h npc_{lanosco}_Quest Q050_LanoscosSpecialBait\">[Lanosco's Special Bait (Done)]</a><br></body></html>"
  S ActionFailed
  S ActionFailed
bypass npc_{lanosco}_Quest Q027_ChestCaughtWithABaitOfWind
  S NpcHtmlMessage obj=lanosco item=0 page=script/quest/Q027_ChestCaughtWithABaitOfWind/31570-05.htm
  S ActionFailed
  S ActionFailed
bypass Quest Q027_ChestCaughtWithABaitOfWind 31570-07.htm
  S QuestList 50:0x00000000 27:0x80000003
  S ExShowQuestMark quest=27
  S SystemMessage id=302 3:6500
  S SystemMessage id=54 3:7625
  S NpcHtmlMessage obj=lanosco item=0 page=script/quest/Q027_ChestCaughtWithABaitOfWind/31570-07.htm
  S ActionFailed
  Q upsert Q027_ChestCaughtWithABaitOfWind | <cond> | 2
  rows Q027_ChestCaughtWithABaitOfWind <cond>=2 <state>=STARTED
  items 6500=0 7625=1
action lanosco
  S ActionFailed
  S NpcHtmlMessage obj=lanosco item=0 page=fisherman/31570.htm
  S ActionFailed
bypass npc_{lanosco}_Quest
  S NpcHtmlMessage obj=lanosco item=0 html="<html><body><a action=\"bypass -h npc_{lanosco}_Quest Q027_ChestCaughtWithABaitOfWind\">[Chest caught with a bait of wind (In Progress)]</a><br><a action=\"bypass -h npc_{lanosco}_Quest Q050_LanoscosSpecialBait\">[Lanosco's Special Bait (Done)]</a><br></body></html>"
  S ActionFailed
  S ActionFailed
bypass npc_{lanosco}_Quest Q027_ChestCaughtWithABaitOfWind
  S NpcHtmlMessage obj=lanosco item=0 page=script/quest/Q027_ChestCaughtWithABaitOfWind/31570-09.htm
  S ActionFailed
  S ActionFailed

# Shaling trades the strange blueprint; the quest completes.
action shaling
action shaling
  S ActionFailed
  S NpcHtmlMessage obj=shaling item=0 page=merchant/31434.htm
  S ActionFailed
bypass npc_{shaling}_Quest
  S NpcHtmlMessage obj=shaling item=0 page=script/quest/Q027_ChestCaughtWithABaitOfWind/31434-01.htm
  S ActionFailed
  S ActionFailed
bypass Quest Q027_ChestCaughtWithABaitOfWind 31434-02.htm
  S SystemMessage id=302 3:7625
  S SystemMessage id=54 3:880
  S PlaySound type=0 file=ItemSound.quest_finish bind=0 obj=0 loc=0,0,0 delay=0
  S QuestList 50:0x00000000 27:0x00000000
  S NpcHtmlMessage obj=shaling item=0 page=script/quest/Q027_ChestCaughtWithABaitOfWind/31434-02.htm
  S ActionFailed
  Q upsert Q027_ChestCaughtWithABaitOfWind | <state> | COMPLETED
  Q delete-except-state Q027_ChestCaughtWithABaitOfWind
  state Q027_ChestCaughtWithABaitOfWind COMPLETED
  rows Q027_ChestCaughtWithABaitOfWind <state>=COMPLETED
  items 7625=0 880=1

# Relog: the completed quest loads from its one row.
relog
  state Q027_ChestCaughtWithABaitOfWind COMPLETED
  rows Q027_ChestCaughtWithABaitOfWind <state>=COMPLETED
  items 880=1
action lanosco
action lanosco
  S ActionFailed
  S NpcHtmlMessage obj=lanosco item=0 page=fisherman/31570.htm
  S ActionFailed
bypass npc_{lanosco}_Quest
  S NpcHtmlMessage obj=lanosco item=0 html="<html><body><a action=\"bypass -h npc_{lanosco}_Quest Q027_ChestCaughtWithABaitOfWind\">[Chest caught with a bait of wind (Done)]</a><br><a action=\"bypass -h npc_{lanosco}_Quest Q050_LanoscosSpecialBait\">[Lanosco's Special Bait (Done)]</a><br></body></html>"
  S ActionFailed
  S ActionFailed
bypass npc_{lanosco}_Quest Q027_ChestCaughtWithABaitOfWind
  S NpcHtmlMessage obj=lanosco item=0 html="<html><body>This quest has already been completed.</body></html>"
  S ActionFailed
  S ActionFailed
