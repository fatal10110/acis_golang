  Q upsert Q033_MakeAPairOfDressShoes | <cond> | 3
  rows Q033_MakeAPairOfDressShoes <cond>=3 <state>=STARTED

# Woodley takes the materials and the adena.
action woodley
  S ActionFailed
  S NpcHtmlMessage obj=woodley item=0 page=merchant/30838.htm
  S ActionFailed
bypass npc_{woodley}_Quest
  S NpcHtmlMessage obj=woodley item=0 page=script/quest/Q033_MakeAPairOfDressShoes/30838-4.htm
  S ActionFailed
  S ActionFailed
bypass Quest Q033_MakeAPairOfDressShoes 30838-5.htm
  S QuestList 37:0x8000007f 33:0x8000000f
  S ExShowQuestMark quest=33
  S PlaySound type=0 file=ItemSound.quest_middle bind=0 obj=0 loc=0,0,0 delay=0
