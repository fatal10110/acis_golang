  S SystemMessage id=301 3:1868 6:600
  S NpcHtmlMessage obj=woodley item=0 page=script/quest/Q033_MakeAPairOfDressShoes/30838-5.htm
  S ActionFailed
  Q upsert Q033_MakeAPairOfDressShoes | <cond> | 4
  items 57=300000 1882=0 1868=0
  rows Q033_MakeAPairOfDressShoes <cond>=4 <state>=STARTED
action woodley
  S ActionFailed
  S NpcHtmlMessage obj=woodley item=0 page=merchant/30838.htm
  S ActionFailed
