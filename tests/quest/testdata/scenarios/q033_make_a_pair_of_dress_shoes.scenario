action ian
  S ActionFailed
  S NpcHtmlMessage obj=ian item=0 page=merchant/30164.htm
  S ActionFailed
bypass npc_{ian}_Quest
  S NpcHtmlMessage obj=ian item=0 page=script/quest/Q033_MakeAPairOfDressShoes/30164-0.htm
  S ActionFailed
  S ActionFailed
bypass Quest Q033_MakeAPairOfDressShoes 30164-1.htm
  S QuestList 37:0x8000007f 33:0x8000001f
  S ExShowQuestMark quest=33
  S PlaySound type=0 file=ItemSound.quest_middle bind=0 obj=0 loc=0,0,0 delay=0
