# Woodley hands over the dress shoes box; the quest completes.
action woodley
action woodley
  S ActionFailed
  S NpcHtmlMessage obj=woodley item=0 page=merchant/30838.htm
  S ActionFailed
bypass npc_{woodley}_Quest
  S NpcHtmlMessage obj=woodley item=0 page=script/quest/Q033_MakeAPairOfDressShoes/30838-6.htm
  S ActionFailed
  S ActionFailed
bypass Quest Q033_MakeAPairOfDressShoes 30838-7.htm
  S SystemMessage id=54 3:7113
  S PlaySound type=0 file=ItemSound.quest_finish bind=0 obj=0 loc=0,0,0 delay=0
  S QuestList 37:0x8000007f 33:0x00000000
  S NpcHtmlMessage obj=woodley item=0 page=script/quest/Q033_MakeAPairOfDressShoes/30838-7.htm
  S ActionFailed
  Q upsert Q033_MakeAPairOfDressShoes | <state> | COMPLETED
  Q delete-except-state Q033_MakeAPairOfDressShoes
  state Q033_MakeAPairOfDressShoes COMPLETED
  rows Q033_MakeAPairOfDressShoes <state>=COMPLETED
  items 7113=1

# Relog: the completed quest loads from its one row, and the box stays.
relog
  state Q033_MakeAPairOfDressShoes COMPLETED
  rows Q033_MakeAPairOfDressShoes <state>=COMPLETED
  items 7113=1
action woodley
action woodley
  S ActionFailed
  S NpcHtmlMessage obj=woodley item=0 page=merchant/30838.htm
  S ActionFailed
bypass npc_{woodley}_Quest
  S NpcHtmlMessage obj=woodley item=0 html="<html><body>This quest has already been completed.</body></html>"
  S ActionFailed
  S ActionFailed
