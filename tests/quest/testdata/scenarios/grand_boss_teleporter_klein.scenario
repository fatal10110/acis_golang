# Klein, the watcher of Valakas (GrandBossTeleporter): with no player sent in yet he answers
# 31540-01.htm (onTalk); his link takes the character's one floating stone and sends it into the
# Lair of Valakas, answering no page (onAdvEvent). His count's other pages, the refusal without
# a stone and the count's reset when Valakas dies are in tests/npcs/teleporters_210_pr4_test.go.
trace internal/gameserver/script/testdata/oracle/scenarios/grand_boss_teleporter_klein.golden
character Pilgrim 60
hold 7267 1
item 7267
script script.teleport.GrandBossTeleporter
page default/31540.htm
page script/teleport/GrandBossTeleporter/
npc klein 31540 Folk 10 0 0

action klein
action klein
  S ActionFailed
  S NpcHtmlMessage obj=klein item=0 page=default/31540.htm
  S ActionFailed
bypass npc_{klein}_Quest GrandBossTeleporter
  S NpcHtmlMessage obj=klein item=0 page=script/teleport/GrandBossTeleporter/31540-01.htm
  S ActionFailed
  S ActionFailed
bypass Quest GrandBossTeleporter 31540
  S SystemMessage id=302 3:7267
  S ActionFailed
  S ActionFailed
  S ActionFailed
  S ActionFailed
  S ActionFailed
  S TeleportToLocation obj=player loc=183813,-115157,-3303 fast=0
  items 7267=0
