  M set MissQueen_Trainees | true
  items 7832=1
action queen
  S ActionFailed
  S NpcHtmlMessage obj=queen item=0 page=default/31760.htm
  S ActionFailed
bypass Quest MissQueen newbie_coupon
  S NpcHtmlMessage obj=queen item=0 page=script/feature/MissQueen/31760-01.htm
  S ActionFailed
  items 7832=1
action queen
  S ActionFailed
  S NpcHtmlMessage obj=queen item=0 page=default/31760.htm
  S ActionFailed
bypass Quest MissQueen traveller_coupon
  S NpcHtmlMessage obj=queen item=0 page=script/feature/MissQueen/31760-06.htm
