# The exit spirit of Anakim's chamber (GatekeeperSpirit): Anakim's death starts the exit timer,
# bound to no NPC and no player, and ten seconds later the exit spirit appears, which sends
# nothing a scenario renders (onMyDying, onTimer); it despawns fifteen minutes after it appears.
# The exit line's own spirit stands there from the start, so the count is one before the timer
# and after the despawn, two while the script's stands. Expectations replay the reference trace
# of this scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/gatekeeper_spirit_anakim.golden
character Pilgrim 40
script script.teleport.GatekeeperSpirit
npc anakim 25286 RaidBoss 40 0 0
npc exit 31112 DungeonGatekeeper -40 0 0

kill anakim
  S SystemMessage id=95 1:0 1:0
  S SystemMessage id=1209
  S PlaySound type=0 file=systemmsg_e.1209 bind=0 obj=0 loc=0,0,0 delay=0
  live 31112 1
advance 10s
  live 31112 2
advance 10m
  live 31112 2
advance 6m
  live 31112 1
