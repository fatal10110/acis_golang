# away by Moira and the quest is not started. Expectations replay the reference trace of this scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q122_ominous_news_low_level.golden
character Courier 19
script quest.Q122_OminousNews
item 57
page trainer/31979.htm
