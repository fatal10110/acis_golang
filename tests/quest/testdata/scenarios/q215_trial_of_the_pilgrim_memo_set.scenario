# Q215_TrialOfThePilgrim, start with the diamonds already paid: the character holds the secondClassChange35 memo, so the start event gives no
# Dimensional Diamonds (no item message, no memo write) and the accept page is the plain one, not the "a" page.
# Hand-written from the quest script (no reference trace).
character Pilgrim 36
class 15
memo secondClassChange35 true
hold 57 100000
script quest.Q215_TrialOfThePilgrim
item 2721 2722 2723 2724 2725 2726 2727 2728 2729 2730 2731 2732 2733 57 7562
page default/30648.htm
page trainer/30571.htm
page default/30649.htm
page default/30550.htm
page default/30651.htm
page default/30650.htm
page trainer/30117.htm
page trainer/30036.htm
page default/30362.htm
page default/30652.htm
page default/30612.htm
page script/quest/Q215_TrialOfThePilgrim/
npc santiago 30648 Folk 10 0 0
npc tanapi 30571 Trainer -10 0 0
npc martankus 30649 Folk 0 10 0
npc gauri 30550 Folk 0 -10 0
npc dorf 30651 Folk 20 20 0
npc gerald 30650 Folk -20 20 0
npc primos 30117 Trainer 20 -20 0
npc petron 30036 Trainer -20 -20 0
npc andellia 30362 Folk 30 0 0
npc uruha 30652 Folk -30 0 0
npc casian 30612 Folk 0 30 0
npc salamander 27116 Monster 40 0 0
npc nahir 27117 Monster -40 0 0
npc willow 27118 Monster 0 -40 0

action santiago
action santiago
  S ActionFailed
  S NpcHtmlMessage obj=santiago item=0 page=default/30648.htm
  S ActionFailed
bypass npc_{santiago}_Quest
  S NpcHtmlMessage obj=santiago item=0 page=script/quest/Q215_TrialOfThePilgrim/30648-03.htm
  S ActionFailed
  S ActionFailed
  state Q215_TrialOfThePilgrim CREATED
bypass Quest Q215_TrialOfThePilgrim 30648-04.htm
  S QuestList 215:0x80000001
  S ExShowQuestMark quest=215
  S PlaySound type=0 file=ItemSound.quest_accept bind=0 obj=0 loc=0,0,0 delay=0
  S SystemMessage id=54 3:2723
  S NpcHtmlMessage obj=santiago item=0 page=script/quest/Q215_TrialOfThePilgrim/30648-04.htm
  S ActionFailed
  Q upsert Q215_TrialOfThePilgrim | <state> | STARTED
  Q upsert Q215_TrialOfThePilgrim | <cond> | 1
  items 2723=1 7562=0 57=100000
