# 1000 Years, the End of Lamentation (Q344), the other relics: at cond 1, three rounds of one
# article each (the special roll 0 under 1 every time) give the old key, the old hilt and the old
# totem (relic rolls 0, 1 and 2). Kaien does not take the key and has nothing to say but his
# first page; Rodemai takes it (roll 95: 885); Kaien takes the hilt (roll 99: 133); Garvarentz
# takes the totem (roll 55: 50 of 1881); Gilmore moves the quest back to cond 1 after each trade.
# Expectations replay the reference trace of this scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q344_1000_years_the_end_of_lamentation_relics.golden
character Watcher 48
quest Q344_1000YearsTheEndOfLamentation <cond>=1 <state>=STARTED
random 0 0 0 95 0 0 1 99 0 0 2 55
script quest.Q344_1000YearsTheEndOfLamentation
item 57 4269 4270 4271 4272 4273 1875 952 2437 1882 1881 191 1874 1887 951 133 1879 885
page default/30754.htm
page default/30756.htm
page villagemaster/30857.htm
page default/30623.htm
page villagemaster/30704.htm
page script/quest/Q344_1000YearsTheEndOfLamentation/
npc gilmore 30754 Folk 10 0 0
npc rodemai 30756 Folk -10 0 0
npc orven 30857 VillageMasterPriest 0 10 0
npc kaien 30623 Folk 0 -10 0
npc garvarentz 30704 VillageMasterOrc 10 10 0
npc servant 20272 Monster 40 0 0

# Round 1: an article, the relic page, the relic.
kill servant
  S SystemMessage id=95 1:0 1:0
  S SystemMessage id=54 3:4269
  S PlaySound type=0 file=ItemSound.quest_itemget bind=0 obj=0 loc=0,0,0 delay=0
