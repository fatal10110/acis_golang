# Wrath of Ancestors (Q272): an orc fighter of level 5 accepts at Livina (a trainer); a goblin tomb
# raider leader and forty-nine goblin grave robbers give fifty heads (a drop that cannot miss), the
# fiftieth moving the quest on; Livina pays 1500 adena, and the repeatable quest ends; then relog.
# Expectations replay the reference trace of this scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q272_wrath_of_ancestors.golden
character Ancestor 5
class 44
script quest.Q272_WrathOfAncestors
item 1474
page trainer/30572.htm
page script/quest/Q272_WrathOfAncestors/
npc livina 30572 Trainer 10 0 0
npc robber 20319 Monster 40 0 0
npc leader 20320 Monster 0 40 0

# Livina: accept.
action livina
action livina
  S ActionFailed
  S NpcHtmlMessage obj=livina item=0 page=trainer/30572.htm
  S ActionFailed
bypass npc_{livina}_Quest
  S NpcHtmlMessage obj=livina item=0 page=script/quest/Q272_WrathOfAncestors/30572-02.htm
  S ActionFailed
  S ActionFailed
  state Q272_WrathOfAncestors CREATED
bypass Quest Q272_WrathOfAncestors 30572-03.htm
  S QuestList 272:0x80000001
  S ExShowQuestMark quest=272
  S PlaySound type=0 file=ItemSound.quest_accept bind=0 obj=0 loc=0,0,0 delay=0
  S NpcHtmlMessage obj=livina item=0 page=script/quest/Q272_WrathOfAncestors/30572-03.htm
  S ActionFailed
  Q upsert Q272_WrathOfAncestors | <state> | STARTED
  Q upsert Q272_WrathOfAncestors | <cond> | 1
  state Q272_WrathOfAncestors STARTED
  rows Q272_WrathOfAncestors <cond>=1 <state>=STARTED

# A tomb raider leader: one head.
kill leader
  S SystemMessage id=95 1:0 1:0
  S SystemMessage id=54 3:1474
  S PlaySound type=0 file=ItemSound.quest_itemget bind=0 obj=0 loc=0,0,0 delay=0
  items 1474=1
action livina
  S ActionFailed
  S NpcHtmlMessage obj=livina item=0 page=trainer/30572.htm
  S ActionFailed
bypass npc_{livina}_Quest
  S NpcHtmlMessage obj=livina item=0 page=script/quest/Q272_WrathOfAncestors/30572-04.htm
  S ActionFailed
