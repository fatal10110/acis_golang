# Collector of Jewels (Q369), keep collecting: a character at cond 2 holding fifty of each shard is paid 12500
# adena by Nell and chooses to go on (30376-07); the quest stays at cond 3; then relog. Expectations replay the
# reference trace of this scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q369_collector_of_jewels_keep.golden
character Jewels 25
quest Q369_CollectorOfJewels <cond>=2 <state>=STARTED
hold 5882 50
hold 5883 50
script quest.Q369_CollectorOfJewels
item 57 5882 5883
page trainer/30376.htm
page script/quest/Q369_CollectorOfJewels/
npc nell 30376 Trainer 10 0 0
npc lakin 20609 Monster 40 0 0
npc rowin 20612 Monster 50 0 0
npc deathfire 20749 Monster 60 0 0
npc undine 20616 Monster -40 0 0
npc rowinundine 20619 Monster -50 0 0
npc roxide 20747 Monster -60 0 0

action nell
action nell
  S ActionFailed
  S NpcHtmlMessage obj=nell item=0 page=trainer/30376.htm
  S ActionFailed
bypass npc_{nell}_Quest
  S QuestList 369:0x80000007
  S ExShowQuestMark quest=369
  S PlaySound type=0 file=ItemSound.quest_middle bind=0 obj=0 loc=0,0,0 delay=0
  S SystemMessage id=301 3:5882 6:50
  S SystemMessage id=301 3:5883 6:50
  S SystemMessage id=52 6:12500
  S NpcHtmlMessage obj=nell item=0 page=script/quest/Q369_CollectorOfJewels/30376-05.htm
  S ActionFailed
  S ActionFailed
  Q upsert Q369_CollectorOfJewels | <cond> | 3
  rows Q369_CollectorOfJewels <cond>=3 <state>=STARTED
  items 5882=0 5883=0 57=12500
bypass Quest Q369_CollectorOfJewels 30376-07.htm
  S PlaySound type=0 file=ItemSound.quest_itemget bind=0 obj=0 loc=0,0,0 delay=0
  S NpcHtmlMessage obj=nell item=0 page=script/quest/Q369_CollectorOfJewels/30376-07.htm
  S ActionFailed
  rows Q369_CollectorOfJewels <cond>=3 <state>=STARTED
relog
  rows Q369_CollectorOfJewels <cond>=3 <state>=STARTED
  items 57=12500
