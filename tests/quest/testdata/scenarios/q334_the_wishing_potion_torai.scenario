# The Wishing Potion (Q334), the forbidden love scroll: a started character holding the scroll
# takes it to Torai, who pays 500000 adena for it and plays the item sound; with no scroll Torai
# says nothing (a started quest, so no refusal page either). Expectations replay the reference
# trace of this scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q334_the_wishing_potion_torai.golden
character Seeker 30
quest Q334_TheWishingPotion <state>=STARTED <cond>=5
hold 3683 1
script quest.Q334_TheWishingPotion
item 57 3683
page default/30557.htm
page script/quest/Q334_TheWishingPotion/
npc torai 30557 Folk 10 0 0

# Torai buys the scroll.
action torai
action torai
  S ActionFailed
  S NpcHtmlMessage obj=torai item=0 page=default/30557.htm
  S ActionFailed
bypass npc_{torai}_Quest
  S PlaySound type=0 file=ItemSound.quest_itemget bind=0 obj=0 loc=0,0,0 delay=0
  S SystemMessage id=302 3:3683
  S SystemMessage id=52 6:500000
  S NpcHtmlMessage obj=torai item=0 page=script/quest/Q334_TheWishingPotion/30557-01.htm
  S ActionFailed
  S ActionFailed
  items 3683=0 57=500000

# Without it he has nothing to say.
action torai
  S ActionFailed
  S NpcHtmlMessage obj=torai item=0 page=default/30557.htm
  S ActionFailed
action torai
  S ActionFailed
  S NpcHtmlMessage obj=torai item=0 page=default/30557.htm
  S ActionFailed
bypass npc_{torai}_Quest
  S NpcHtmlMessage obj=torai item=0 html="<html><body>You are either not on a quest that involves this NPC, or you don't meet this NPC's minimum quest requirements.</body></html>"
  S ActionFailed
  S ActionFailed
  items 57=500000
