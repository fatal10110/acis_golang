  S ActionFailed
bypass Quest VarkaSilenosSupport 7
  S SystemMessage id=301 3:7187 6:6
  S NpcHtmlMessage obj=udan item=0 page=script/feature/VarkaSilenosSupport/31379-4.htm
  S ActionFailed
  items 7187=0
action hagos
action hagos
  S ActionFailed
  S NpcHtmlMessage obj=hagos item=0 page=script/feature/VarkaSilenosSupport/31381-3.htm
  S ActionFailed
bypass Quest VarkaSilenosSupport Withdraw
  S NpcHtmlMessage obj=hagos item=0 page=script/feature/VarkaSilenosSupport/31381-0.htm
  S ActionFailed

kill recruit
  S SystemMessage id=302 3:7225
  S SystemMessage id=54 3:7224
  S QuestList
  S SystemMessage id=301 3:7226 6:3
  Q delete-quest Q611_AllianceWithVarkaSilenos
  rows Q611_AllianceWithVarkaSilenos -
  items 7225=0 7224=1

action ashas
action ashas
  S ActionFailed
  S NpcHtmlMessage obj=ashas item=0 page=script/feature/VarkaSilenosSupport/31377-no.htm
