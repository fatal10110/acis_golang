# Dwarven Kinship (Q167), kept by Haprock: a level 15 character accepts at Carlon; Haprock keeps
# the letter himself for more adena, and the quest completes without Norman. Expectations
# replay the reference trace of this scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q167_dwarven_kinship_haprock.golden
character Kinsman 15
script quest.Q167_DwarvenKinship
item 1076 1106 57
page warehouse/30350.htm
page warehouse/30255.htm
page script/quest/Q167_DwarvenKinship/
npc carlon 30350 WarehouseKeeper 10 0 0
npc haprock 30255 WarehouseKeeper 20 0 0

# Carlon: accept with his letter.
action carlon
action carlon
  S ActionFailed
  S NpcHtmlMessage obj=carlon item=0 page=warehouse/30350.htm
  S ActionFailed
bypass npc_{carlon}_Quest
  S NpcHtmlMessage obj=carlon item=0 page=script/quest/Q167_DwarvenKinship/30350-03.htm
  S ActionFailed
  S ActionFailed
bypass Quest Q167_DwarvenKinship 30350-04.htm
  S QuestList 167:0x80000001
  S ExShowQuestMark quest=167
  S PlaySound type=0 file=ItemSound.quest_accept bind=0 obj=0 loc=0,0,0 delay=0
  S SystemMessage id=54 3:1076
  S NpcHtmlMessage obj=carlon item=0 page=script/quest/Q167_DwarvenKinship/30350-04.htm
  S ActionFailed
  Q upsert Q167_DwarvenKinship | <state> | STARTED
  Q upsert Q167_DwarvenKinship | <cond> | 1
  items 1076=1

# Haprock: he keeps the letter for adena; the quest completes.
action haprock
action haprock
  S ActionFailed
  S NpcHtmlMessage obj=haprock item=0 page=warehouse/30255.htm
  S ActionFailed
bypass npc_{haprock}_Quest
  S NpcHtmlMessage obj=haprock item=0 page=script/quest/Q167_DwarvenKinship/30255-01.htm
  S ActionFailed
  S ActionFailed
bypass Quest Q167_DwarvenKinship 30255-02.htm
  S NpcHtmlMessage obj=haprock item=0 page=script/quest/Q167_DwarvenKinship/30255-02.htm
  S ActionFailed
bypass Quest Q167_DwarvenKinship 30255-04.htm
  S SystemMessage id=302 3:1076
  S SystemMessage id=52 6:3000
  S PlaySound type=0 file=ItemSound.quest_finish bind=0 obj=0 loc=0,0,0 delay=0
  S QuestList 167:0x00000000
  S NpcHtmlMessage obj=haprock item=0 page=script/quest/Q167_DwarvenKinship/30255-04.htm
  S ActionFailed
  Q upsert Q167_DwarvenKinship | <state> | COMPLETED
  Q delete-except-state Q167_DwarvenKinship
  items 1076=0 1106=0 57=3000
  state Q167_DwarvenKinship COMPLETED
  rows Q167_DwarvenKinship <state>=COMPLETED
