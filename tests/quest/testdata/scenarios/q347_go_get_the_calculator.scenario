  S ActionFailed
bypass Quest Q347_GoGetTheCalculator 30526-04.htm
  S NpcHtmlMessage obj=brunon item=0 page=script/quest/Q347_GoGetTheCalculator/30526-04.htm
  S ActionFailed
bypass Quest Q347_GoGetTheCalculator 30526-05.htm
  S QuestList 347:0x80000001
  S ExShowQuestMark quest=347
  S PlaySound type=0 file=ItemSound.quest_accept bind=0 obj=0 loc=0,0,0 delay=0
  S NpcHtmlMessage obj=brunon item=0 page=script/quest/Q347_GoGetTheCalculator/30526-05.htm
  S ActionFailed
  Q upsert Q347_GoGetTheCalculator | <state> | STARTED
  Q upsert Q347_GoGetTheCalculator | <cond> | 1
  state Q347_GoGetTheCalculator STARTED
  rows Q347_GoGetTheCalculator <cond>=1 <state>=STARTED

# Silvera: nothing before cond 4.
action silvera
action silvera
  S ActionFailed
  S NpcHtmlMessage obj=silvera item=0 page=trainer/30527.htm
  S ActionFailed
bypass npc_{silvera}_Quest
  S NpcHtmlMessage obj=silvera item=0 page=script/quest/Q347_GoGetTheCalculator/30527-00.htm
  S ActionFailed
  S ActionFailed

