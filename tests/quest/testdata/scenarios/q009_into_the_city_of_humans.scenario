# Into the City of Humans (Q009): an orc of level 3 accepts at Petukai, visits Tanapi, then Tamil,
# who rewards the trip with a mark of traveler and a scroll of escape to Giran; then relog.
# Expectations replay the reference trace of this scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q009_into_the_city_of_humans.golden
character Roamer 3
class 44
script quest.Q009_IntoTheCityOfHumans
item 7559 7570
