# Gather Ingredients for Pie (Q299): a level 34 character accepts at Emily. A hundred wasp workers give
# a hundred honey pouches (every roll pinned to 0), the hundredth moving the quest on; Emily takes them
# and sends the player to Lara for Avellan spice, takes the spice and sends the player to Bright for a
# fruit basket, and takes the basket for 25000 adena; the repeatable quest ends; then relog.
# Expectations replay the reference trace of this scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q299_gather_ingredients_for_pie.golden
character Baker 34
random always 0
script quest.Q299_GatherIngredientsForPie
item 7136 7137 7138
page default/30620.htm
page merchant/30063.htm
page guard/30466.htm
page script/quest/Q299_GatherIngredientsForPie/
npc emily 30620 Folk 10 0 0
npc lara 30063 Merchant -10 0 0
npc bright 30466 Guard 0 10 0
npc wasp 20934 Monster 40 0 0

# Emily: accept.
action emily
action emily
  S ActionFailed
  S NpcHtmlMessage obj=emily item=0 page=default/30620.htm
  S ActionFailed
bypass npc_{emily}_Quest
  S NpcHtmlMessage obj=emily item=0 page=script/quest/Q299_GatherIngredientsForPie/30620-0.htm
  S ActionFailed
  S ActionFailed
  state Q299_GatherIngredientsForPie CREATED
bypass Quest Q299_GatherIngredientsForPie 30620-1.htm
  S QuestList 299:0x80000001
  S ExShowQuestMark quest=299
  S PlaySound type=0 file=ItemSound.quest_accept bind=0 obj=0 loc=0,0,0 delay=0
  S NpcHtmlMessage obj=emily item=0 page=script/quest/Q299_GatherIngredientsForPie/30620-1.htm
  S ActionFailed
  Q upsert Q299_GatherIngredientsForPie | <state> | STARTED
  Q upsert Q299_GatherIngredientsForPie | <cond> | 1
  state Q299_GatherIngredientsForPie STARTED
  rows Q299_GatherIngredientsForPie <cond>=1 <state>=STARTED

# Emily: no honey yet.
action emily
  S ActionFailed
  S NpcHtmlMessage obj=emily item=0 page=default/30620.htm
  S ActionFailed
bypass npc_{emily}_Quest
  S NpcHtmlMessage obj=emily item=0 page=script/quest/Q299_GatherIngredientsForPie/30620-1a.htm
  S ActionFailed
  S ActionFailed

# A hundred honey pouches.
kill wasp x100
