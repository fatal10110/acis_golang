# Pavel's Research (Q120), Doctor Chaos's bookshelf's cast: the character plays cond 12 to 15 as in
# q120_pavels_research_east, and the lockup report's bypass asks Doctor Chaos's bookshelf to cast
# Quest Trap - Power Shot (5073, level 5) at it (onAdvEvent, 32045-02.htm); it casts within the next
# three AI ticks; the reference casts on the second. Expectations replay the reference trace of this
# scenario.
trace internal/gameserver/script/testdata/oracle/scenarios/q120_pavels_research_shelf_cast.golden
character Researcher 50
quest Q114_ResurrectionOfAnOldManager <state>=COMPLETED
quest Q120_PavelsResearch <cond>=12 <state>=STARTED
hold 8059 1
script quest.Q114_ResurrectionOfAnOldManager
script quest.Q120_PavelsResearch
item 8058 8059 8060 8290 8291 8292 854
page default/32046.htm
page default/32047.htm
page default/32041.htm
page default/32042.htm
page default/32043.htm
page default/32044.htm
page default/32045.htm
page script/quest/Q120_PavelsResearch/
npc stones 32046 Folk 10 0 0
npc wendy 32047 Folk 20 0 0
npc yumi 32041 Folk 30 0 0
npc north 32042 Folk 0 10 0
npc east 32043 Folk 0 20 0
npc west 32044 Folk 0 30 0
npc shelf 32045 Folk -10 0 0

action stones
action stones
  S ActionFailed
  S NpcHtmlMessage obj=stones item=0 page=default/32046.htm
  S ActionFailed
bypass npc_{stones}_Quest
  S NpcHtmlMessage obj=stones item=0 html="<html><body><a action=\"bypass -h npc_{stones}_Quest Q114_ResurrectionOfAnOldManager\">[Resurrection of an Old Manager (Done)]</a><br><a action=\"bypass -h npc_{stones}_Quest Q120_PavelsResearch\">[Pavel's Research (In Progress)]</a><br></body></html>"
  S ActionFailed
  S ActionFailed
bypass npc_{stones}_Quest Q120_PavelsResearch
  S NpcHtmlMessage obj=stones item=0 page=script/quest/Q120_PavelsResearch/32046-26.htm
  S ActionFailed
  S ActionFailed
bypass Quest Q120_PavelsResearch 32046-27.htm
  S NpcHtmlMessage obj=stones item=0 page=script/quest/Q120_PavelsResearch/32046-27.htm
  S ActionFailed
bypass Quest Q120_PavelsResearch 32046-28.htm
  S NpcHtmlMessage obj=stones item=0 page=script/quest/Q120_PavelsResearch/32046-28.htm
  S ActionFailed
bypass Quest Q120_PavelsResearch 32046-28a.htm
  S NpcHtmlMessage obj=stones item=0 page=script/quest/Q120_PavelsResearch/32046-28a.htm
  S ActionFailed
bypass Quest Q120_PavelsResearch 32046-28.htm
  S NpcHtmlMessage obj=stones item=0 page=script/quest/Q120_PavelsResearch/32046-28.htm
  S ActionFailed
bypass Quest Q120_PavelsResearch 32046-29.htm
  S QuestList 114:0x00000000 120:0x80001fff
  S ExShowQuestMark quest=120
  S PlaySound type=0 file=ItemSound.quest_middle bind=0 obj=0 loc=0,0,0 delay=0
  S NpcHtmlMessage obj=stones item=0 page=script/quest/Q120_PavelsResearch/32046-29.htm
  S ActionFailed
  Q upsert Q120_PavelsResearch | <cond> | 13
  rows Q120_PavelsResearch <cond>=13 <state>=STARTED

action wendy
action wendy
  S ActionFailed
  S NpcHtmlMessage obj=wendy item=0 page=default/32047.htm
  S ActionFailed
bypass npc_{wendy}_Quest
  S NpcHtmlMessage obj=wendy item=0 html="<html><body><a action=\"bypass -h npc_{wendy}_Quest Q114_ResurrectionOfAnOldManager\">[Resurrection of an Old Manager (Done)]</a><br><a action=\"bypass -h npc_{wendy}_Quest Q120_PavelsResearch\">[Pavel's Research (In Progress)]</a><br></body></html>"
  S ActionFailed
