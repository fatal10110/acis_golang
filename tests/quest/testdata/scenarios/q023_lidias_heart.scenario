  S NpcHtmlMessage obj=innocentin item=0 html="<html><body><a action=\"bypass -h npc_{innocentin}_Quest Q022_TragedyInVonHellmannForest\">[Tragedy in von Hellmann Forest (Done)]</a><br><a action=\"bypass -h npc_{innocentin}_Quest Q023_LidiasHeart\">[Lidia's Heart]</a><br></body></html>"
  S ActionFailed
  S ActionFailed
bypass npc_{innocentin}_Quest Q023_LidiasHeart
  S NpcHtmlMessage obj=innocentin item=0 page=script/quest/Q023_LidiasHeart/31328-01.htm
  S ActionFailed
  S ActionFailed
  state Q023_LidiasHeart CREATED
bypass Quest Q023_LidiasHeart 31328-02.htm
  S QuestList 22:0x00000000 23:0x80000001
  S ExShowQuestMark quest=23
  S PlaySound type=0 file=ItemSound.quest_accept bind=0 obj=0 loc=0,0,0 delay=0
  S SystemMessage id=54 3:7063
  S SystemMessage id=54 3:7149
  S NpcHtmlMessage obj=innocentin item=0 page=script/quest/Q023_LidiasHeart/31328-02.htm
  S ActionFailed
  Q upsert Q023_LidiasHeart | <state> | STARTED
  Q upsert Q023_LidiasHeart | <cond> | 1
  items 7063=1 7149=1
bypass Quest Q023_LidiasHeart 31328-03.htm
  S NpcHtmlMessage obj=innocentin item=0 page=script/quest/Q023_LidiasHeart/31328-03.htm
  S ActionFailed
bypass Quest Q023_LidiasHeart 31328-05.htm
  S NpcHtmlMessage obj=innocentin item=0 page=script/quest/Q023_LidiasHeart/31328-05.htm
  S ActionFailed
