# The diary's last help page, opened for the diary item at cond 5, marks it read (the
# server's bypass handler writes the quest's diary variable that the script reads back).
bypass player_help lidias_diary/7064-16.htm#7064
  S NpcHtmlMessage obj=0 item=7064 page=help/lidias_diary/7064-16.htm
  Q upsert Q023_LidiasHeart | diary | 1
  rows Q023_LidiasHeart <cond>=5 <state>=STARTED diary=1

